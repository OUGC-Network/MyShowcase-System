<a name="{{ comment_data.comment_slug }}" id="{{ comment_data.comment_slug }}"></a>
{% if is_deleted %}
    <div class="post post--message deleted_comment_collapsed" id="deleted_comment_{{ comment_data.comment_slug }}">
        <div class="post__meta">
            <h3 class="post__author">{{ userProfileLink|raw }}</h3>
        </div>
        <div class="post__body post__body--message post_body" id="deleted_post{{ comment_data.comment_slug }}">
            {{ deletedMessage }}
            <div class="post--message__button" id="show_deleted_link_{{ comment_data.comment_slug }}">
                <a href="javascript:void(0)"
                   onclick="Showcase.showDeletedComment('{{ comment_data.comment_slug }}'); return false;"
                   class="button">
                    {{ include('partials/icon.twig', {icon: 'eye', class: 'button__icon'}, with_context = false) }}
                    <span class="button__text">{{ lang.myShowcaseCommentDeletedSButtonShow }}</span>
                </a>
            </div>
            <script type="text/javascript">
                <!--
                $('#show_deleted_link_{{ comment_data.comment_slug }}').show();
                // -->
            </script>
        </div>
    </div>
{% endif %}

{% if is_ignored %}
    <div class="ignored_post" id="ignored_comment_{{ comment_data.comment_slug }}">
        <div class="ignored_post_author"><strong><span class="largetext">{{ userProfileLink|raw }}</span></strong></div>
        <div class="ignored_post_message">
            <div class="show_ignored_post float_right" style="vertical-align: top;"
                 id="show_ignored_link_{{ comment_data.comment_slug }}"><a
                        href="javascript:void(0)"
                        onclick="Showcase.showIgnoredComment('{{ comment_data.comment_slug }}'); return false;"
                        class="button small_button"><span>{{ lang.myShowcaseCommentDeletedSButtonShow }}</span></a>
            </div>
            <script type="text/javascript">
                <!--
                $('#show_ignored_link_{{ comment_data.comment_slug }}').show();
                // -->
            </script>
            {{ ignored_message|raw }}
        </div>
    </div>
{% endif %}

{# Post bit #}
<div class="post {{ style_class }}" style="{{ style_visibility }}" id="commentBody{{ comment_data.comment_slug }}">
    <div class="post__meta">
        {# Author avatar #}
        {% if mybb.user.showavatars is defined and mybb.user.showavatars is not empty %}
            <a href="{{ userProfileLinkPlain|raw }}" class="avatar-profile-link">
                {% if userData.avatar %}
                    <img src="{{ user_avatar.image }}" alt="" {{ user_avatar.width_height|raw }} class="avatar"/>
                {% else %}
                    {% include 'partials/default_avatar.twig' %}
                {% endif %}
            </a>
        {% endif %}

        {# Author username #}
        <h3 class="post__author">
            {{ userProfileLink|raw }}
            {# Online status #}
            {% if userOnlineStatus == 'online' %}
                <span class="user-status user-status--online">
    <a href="online.php" title="{{ lang.myShowcaseCommentOnlineStatusOnline }}"
       class="user-status__link">
        {{ include('partials/icon.twig', {icon: 'dot-circle', class: 'user-status__icon', title: lang.myShowcaseCommentOnlineStatusOnline}, with_context = false) }}
    </a>
</span>
            {% elseif userOnlineStatus == 'away' %}
                <span class="user-status user-status--away">
    <a href="{{ userProfileLinkPlain|raw }}" title="{{ lang.myShowcaseCommentOnlineStatusAway }}"
       class="user-status__link">
        {{ include('partials/icon.twig', {icon: 'dot-circle', class: 'user-status__icon', title: lang.myShowcaseCommentOnlineStatusAway}, with_context = false) }}
    </a>
</span>
            {% else %}
                <span class="user-status user-status--offline">
    {{ include('partials/icon.twig', {icon: 'dot-circle', class: 'user-status__icon', title: lang.myShowcaseCommentOnlineStatusOffline}, with_context = false) }}
</span>
            {% endif %}
            {{ userOnlineStatus|raw }}
        </h3>

        {# Post date & permalink #}
        <a href="{{ commentUrl }}}#{{ comment_data.comment_slug }}" title="{{ entrySubject }}" class="post__date">
            {{ date|my_date }}
        </a>

        {# Inline moderation checkbox #}
        {% if permissions.can_manage_entries and  false %}
            <input type="checkbox" class="checkbox post__inline-mod" name="inlinemod_{{ comment_data.comment_slug }}"
                   id="inlinemod_{{ comment_data.comment_slug }}" value="1"
                   {% if comment_data.inlinechecked %}checked="checked"{% endif %}/>
        {% endif %}

        {% if false and edited_by %}
            {# TO DO : CLEAN UP EDITED MESSAGE #}
            <a href="#" class="post__edit-log" title=""
               id="edited_by_{{ entry_slug }}">{{ include('partials/icon.twig', {icon:
                    'pencil-alt', class: ''}, with_context = false) }}</a>
            <span class="edited_post"
                  style="display: none;">({{ myShowcaseCommentEditedBy|raw }} {{ edited_by.editUserProfileLink|raw }}.)</span>
        {% endif %}
    </div>

    {# Post body #}
    <div class="post__body post_body scaleimages" id="pid_{{ comment_data.comment_slug }}">
        {# Post unapproved or deleted message #}
        {% if false and comment_data.status %}
            <div class="post__status">
                <span class="tag tag--post-status{% if comment_data.is_deleted %} tag--deleted{% endif %}{% if comment_data.status == 0 %} tag--awaiting-approval{% endif %}">{{ comment_data.status_type }}</span>
            </div>
        {% endif %}

        {# Post message #}
        {{ commentMessage|raw }}

        {# Attachments #}
        {{ commentAttachments|raw }}

        {# Signature #}
        {% if userSignature %}
            <div class="post__signature scaleimages">
                {{ userSignature|raw }}
            </div>
        {% endif %}
    </div>

    {# Post controls #}
    <div class="post__foot post__foot--controls">
        <div class="post-controls post-controls--primary">
            {# Restore button (for deleted posts) #}
            {% if false and comment_data.quick_restore %}
                <a href="editcommet_data.php?pid={{ comment_data.comment_slug }}"
                   onclick="Thread.restorePost({{ comment_data.comment_slug }}); return false;"
                   id="quick_restore_{{ comment_data.comment_slug }}"
                   title="{{ lang.postbit_quick_restore }}" class="post-control post-control--restore">
                    {{ include('partials/icon.twig', {icon: 'circle', class: 'post-control__icon fa-fw'}, with_context = false) }}
                    <span class="post-control__text">{{ lang.postbit_button_qrestore }}</span>
                </a>
                <script type="text/javascript">
                    // <!--
                    $('#quick_restore_{{ comment_data.comment_slug }}').css('display', '{{ comment_data.quick_restore_display }}');
                    // -->
                </script>
            {% endif %}

            {# Reply to post button #}
            {# TO DO : Show reply button in threaded mode #}
            {% if false and comment_data.button_quote %}
                {# <a href="newreply.php?tid={{ comment_data.tid }}&amp;replyto={{ comment_data.comment_slug }}" title="{{ lang.postbit_quote }}" class="post-control post-control--reply">{{ include('partials/icon.twig', {icon: 'comments', class: 'post-control__icon fa-fw'}, with_context = false) }}</i><span class="post-control__text">{{ lang.postbit_button_quote }}</span></a> #}
            {% endif %}

            {# Multiquote button #}
            {% if false and comment_data.button_multiquote %}
                <a href="javascript:void(0)" onclick="Thread.multiQuote({{ comment_data.comment_slug }}); return false;"
                   id="multiquote_link_{{ comment_data.comment_slug }}" title="{{ lang.postbit_multiquote }}"
                   class="postbit_multiquote post-control post-control--quote">
                    {{ include('partials/icon.twig', {icon: 'quote-left', class: 'post-control__icon fa-fw'}, with_context = false) }}
                    <span id="multiquote_{{ comment_data.comment_slug }}"
                          class="post-control__text">{{ lang.postbit_button_multiquote }}</span>
                </a>
                <script type="text/javascript">
                    //<!--
                    $('#multiquote_link_{{ comment_data.comment_slug }}').css("display", "");
                    // -->
                </script>
            {% endif %}

            {# Reputation button #}
            {% if false and comment_data.button_rep %}
                <a href="javascript:void(0)"
                   onclick="MyBB.reputation({{ comment_data.uid }}, {{ comment_data.comment_slug }}); return false;"
                   title="{{ lang.postbit_reputation_add }}" class="post-control post-control--rate">
                    {{ include('partials/icon.twig', {icon: 'thumbs-up', class: 'post-control__icon fa-fw'}, with_context = false) }}
                    <span class="post-control__text">{{ lang.postbit_button_reputation_add }}</span>
                </a>
            {% endif %}
        </div>
        <div class="post-controls post-controls--secondary post-options">
            {% if url_comment_edit %}
                <a href="{{ url_comment_edit }}" class="post-control post-control--quick-edit quick_edit_button"
                   id="quick_edit_comment_{{ comment_data.comment_slug }}"
                   title="{{ lang.myShowcaseCommentButtonEditDescription }}">
                    {{ include('partials/icon.twig', {icon: 'pencil-alt', class: 'post-control__icon fa-fw'}, with_context = false) }}
                    <span class="post-control__text">{{ lang.myShowcaseCommentButtonEdit }}</span>
                </a>
            {% endif %}
            {% if false and (show_warn_button or show_purge_spammer_button or show_report_button or url_comment_approve or url_comment_unapprove or url_comment_restore or url_comment_soft_delete or url_comment_deleteclass) %}
                <input type="checkbox" class="post-options__checkbox" id="post_options_{{ comment_data.comment_slug }}">
                <label for="post_options_{{ comment_data.comment_slug }}"
                       class="post-control post-control--options post-options__control"
                       title="{{ lang.postbit_post_options }}">
                    {{ include('partials/icon.twig', {icon: 'ellipsis-v', class: 'post-control__icon fa-fw'}, with_context = false) }}
                    <span class="visually-hidden">{{ lang.postbit_post_options }}</span>
                </label>
                <span class="post-options__list" id="post_options2_{{ comment_data.comment_slug }}">
                {# Edit button #}
                    {% if url_comment_approve %}
                        <form id="approveCommentForm{{ comment_data.comment_slug }}" action="{{ approveUrl }}"
                              method="post"
                              style="display:none;">
    <input type="hidden" name="my_post_key" value="{{ mybb.post_code }}"/>
</form>
                        <a href="javascript:void(0)"
                           onclick="Showcase.confirmSubmit('{{ lang.myShowcaseCommentButtonApproveConfirm }}', 'approveCommentForm{{ comment_data.comment_slug }}');"
                           title="{{ lang.myShowcaseCommentButtonApproveDescription }}"
                           class="post-control post-control--delete">
    {{ include('partials/icon.twig', {icon: 'trash', class: 'post-control__icon fa-fw'}, with_context = false) }}
    <span class="post-control__text">{{ lang.myShowcaseCommentButtonApprove }}</span>
</a>
                    {% elseif url_comment_unapprove %}
                        <form id="unapproveCommentForm{{ comment_data.comment_slug }}" action="{{ unapproveUrl }}"
                              method="post"
                              style="display:none;">
                        <input type="hidden" name="my_post_key" value="{{ mybb.post_code }}"/>
                        </form>
                        <a href="javascript:void(0)" title="{{ lang.myShowcaseCommentButtonUnapproveDescription }}"
                           class="postbit_qdelete"
                           onclick="Showcase.confirmSubmit('{{ lang.myShowcaseCommentButtonUnapproveConfirm }}', 'unapproveCommentForm{{ comment_data.comment_slug }}');">
    <span>{{ lang.myShowcaseCommentButtonUnapprove }}</span>
</a>
                    {% endif %}

                    {% if url_comment_delete %}
                        <form id="deleteComment{{ comment_data.comment_slug }}" action="{{ deleteUrl }}" method="post"
                              style="display:none;">
                            <input type="hidden" name="my_post_key" value="{{ mybb.post_code }}"/>
                        </form>
                        <a href="javascript:void(0)"
                           onclick="Showcase.confirmSubmit('{{ lang.myShowcaseCommentButtonDeleteConfirm }}', 'deleteComment{{ comment_data.comment_slug }}');"
                           id="quick_delete_{{ comment_data.comment_slug }}"
                           title="{{ lang.myShowcaseCommentButtonDeleteDescription }}"
                           class="post-control post-control--delete">
    {{ include('partials/icon.twig', {icon: 'trash', class: 'post-control__icon fa-fw'}, with_context = false) }}
                            <span class="post-control__text">{{ lang.myShowcaseCommentButtonDelete }}</span>
                        </a>
                        <script type="text/javascript">
                            // <!--
                            $('#quick_delete_{{ comment_data.comment_slug }}').css('display', '{{ comment_data.quick_delete_display }}');
                            // -->
                        </script>
                    {% endif %}

                    {# Delete button #}
                    {% if url_comment_restore %}
                        <form id="restoreCommentForm{{ comment_data.comment_slug }}" action="{{ restoreUrl }}"
                              method="post"
                              style="display:none;">
                            <input type="hidden" name="my_post_key" value="{{ mybb.post_code }}"/>
                        </form>
                        <a href="javascript:void(0)" title="{{ lang.myShowcaseCommentButtonRestoreDescription }}"
                           class="postbit_qrestore"
                           onclick="Showcase.confirmSubmit('{{ lang.myShowcaseCommentButtonRestoreConfirm }}', 'restoreCommentForm{{ comment_data.comment_slug }}');">
                            <span>{{ lang.myShowcaseCommentButtonRestore }}</span>
                        </a>
                    {% elseif url_comment_soft_delete %}
                        <form id="softDeleteCommentForm{{ comment_data.comment_slug }}" action="{{ softDeleteUrl }}"
                              method="post"
                              style="display:none;">
                            <input type="hidden" name="my_post_key" value="{{ mybb.post_code }}"/>
                        </form>
                        <a href="javascript:void(0)" title="{{ lang.myShowcaseCommentButtonSoftDeleteDescription }}"
                           class="postbit_qdelete"
                           onclick="Showcase.confirmSubmit('{{ lang.myShowcaseCommentButtonSoftDeleteConfirm }}', 'softDeleteCommentForm{{ comment_data.comment_slug }}');">
                            <span>{{ lang.myShowcaseCommentButtonSoftDelete }}</span>
                        </a>
                    {% endif %}

                    {# Report button #}
                    {% if show_report_button %}
                        <a href="javascript:void(0)"
                           onclick="Showcase.reportComment('{{ comment_data.comment_slug }}', {{ showcaseID }}); return false;"
                           title="{{ lang.myShowcaseCommentButtonReportDescription }}"
                           class="post-control post-control--report">
    {{ include('partials/icon.twig', {icon: 'flag', class: 'post-control__icon fa-fw'}, with_context = false) }}
                            <span class="post-control__text">{{ lang.myShowcaseCommentButtonReport }}</span>
                        </a>
                    {% endif %}

                    {# Warn user button #}
                    {% if show_warn_button %}
                        <a href="warnings.php?action=warn&amp;uid={{ userID }}&amp;showcase_id={{ showcaseID }}&amp;comment_slug={{ comment_data.comment_slug }}"
                           title="{{ lang.myShowcaseCommentButtonWarnDescription }}"
                           class="post-control post-control--warn">
                            {{ include('partials/icon.twig', {icon: 'exclamation-triangle', class: 'post-control__icon fa-fw'}, with_context =
                                false) }}
                            <span class="post-control__text">{{ lang.myShowcaseCommentButtonWarn }}</span>
                        </a>
                    {% endif %}

                    {# Purge spammer button #}
                    {% if false and show_purge_spammer_button %}
                        <a href="moderation.php?action=purgespammer&amp;uid={{ userID }}"
                           title="{{ lang.myShowcaseCommentButtonPurseSpammerDescription }}"
                           class="post-control post-control--purge-spammer">
    {{ include('partials/icon.twig', {icon: 'gavel', class: 'post-control__icon fa-fw'}, with_context = false) }}
                            <span class="post-control__text">{{ lang.myShowcaseCommentButtonPurseSpammer }}</span>
                        </a>
                    {% endif %}
            </span>
            {% endif %}
        </div>
    </div>
</div>