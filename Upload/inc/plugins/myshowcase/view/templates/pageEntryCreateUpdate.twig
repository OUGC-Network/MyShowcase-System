{% extends 'layouts/master.twig' %}

{% block head %}
    <title>{{ trans('newthread_in', forum.name) }} - {{ mybb.settings.bbname }}</title>
{% endblock head %}

{% block jscripts %}
    <script type="text/javascript"
            src="{{ mybb.settings.bburl }}/jscripts/myshowcase.js?ver={{ showcase.version }}"></script>
    <script type="text/javascript">
        <!--
        const removeshowcase_confirm = "{{ lang.removeshowcase_confirm }}";
        const removeshowcasecomment_confirm = "{{ lang.removeshowcasecomment_confirm }}";
        const removeshowcaseattach_confirm = "{{ lang.removeshowcaseattach_confirm }}";
        const showcase_url = "{{ url_main }}";
        // -->
    </script>
{% endblock jscripts %}

{% block body %}
    <div class="page-content">
        <header class="page-header">
            <h1 class="title title--page">{{ lang.myShowcaseNewEditFormTitle }}</h1>
        </header>
        {% if preview %}
            <section class="block block--container">
                <h1 class="title title--major title--separation">{{ lang.myShowcaseNewEditEntryPreview }}</h1>
                <div id="posts_container">
                    <div id="posts">
                        {{ entryPreview|raw }}
                    </div>
                </div>
            </section>
        {% endif %}
        {{ errors|raw }}
        <form action="{{ url_base }}{{ createUpdateUrl }}" method="post"
              enctype="multipart/form-data" name="input" id="contentForm"></form>
        <div class="form form--compose compose">
            <section class="section section--form compose__primary-section">
                {% for field_id, field_data in fieldSetCache %}
                    <div class="row row--form field">
                        <h3 class="field__name visually-hidden">
                            <label for="{{ field_data.field_key }}">{{ fieldHeader }}</label>
                        </h3>
                        {% if field_data.description is not empty %}
                            <p class="field__description">{{ field_data.description }}</p>
                        {% endif %}
                        <div class="{% if field_data.enable_subject %}compose__subject{% else %}compose__container{% endif %}">
                            {% if field_data.html_type in ['text', 'search', 'textarea'] and field_data.enable_editor %}
                            <div class="compose__message compose__{{ field_data.field_key }}">
                                {% endif %}
                                {% if field_data.html_type == 'radio' %}
                                    <div id="{{ field_data.field_key }}">
                                        {% for field_data_id, field_data_data in field_data.fieldDataObjects %}
                                            <p class="option-field option-field--compact">
                                                <label>
                                                    <input type="radio"
                                                           name="{{ field_data.field_key }}"
                                                           value="{{ field_data_id }}"
                                                           tabindex="{{ loop.index + 10 }}"
                                                           {% if field_data.is_required %}required="required"{% endif %}
                                                            {% if mybb.input[field_data.field_key] == field_data_id %}checked="checked"{% endif %}
                                                           form="contentForm"/>
                                                    {{ field_data_data.value }}
                                                </label>
                                            </p>
                                        {% endfor %}
                                    </div>
                                {% elseif field_data.html_type == 'text' %}
                                    <input type="text"
                                           name="{{ field_data.field_key }}"
                                           value="{{ mybb.input[field_data.field_key] }}"
                                           tabindex="{{ loop.index + 10 }}"
                                           placeholder="{{ field_data.placeholder }}"
                                           {% if field_data.is_required %}required="required"{% endif %}
                                           maxlength="{{ field_data.maximum_length }}"
                                           minlength="{{ field_data.minimum_length }}"
                                           class="textbox {% if field_data.enable_subject %}textbox--subject{% endif %}"
                                           step="{{ fieldData.step_size }}"
                                            {% if field_data.regular_expression %}pattern="{{ field_data.regular_expression }}"{% endif %}
                                           id="{{ field_data.field_key }}"
                                           form="contentForm"/>
                                {% elseif field_data.html_type == 'textarea' %}
                                    <textarea name="{{ field_data.field_key }}"
                                              tabindex="{{ loop.index + 10 }}"
                                              placeholder="{{ field_data.placeholder }}"
                                              {% if field_data.is_required %}required="required"{% endif %}
                                              maxlength="{{ field_data.maximum_length }}"
                                              minlength="{{ field_data.minimum_length }}"
                                              rows="20"
                                              cols="70"
                                              id="{{ field_data.field_key }}"
                                              form="contentForm">{{ mybb.input[field_data.field_key] }}</textarea>
                                {% elseif field_data.html_type == 'select' %}
                                    <select name="{{ field_data.field_key }}"
                                            tabindex="{{ loop.index + 10 }}"
                                            {% if field_data.is_required %}required="required"{% endif %}
                                            id="{{ field_data.field_key }}"
                                            form="contentForm">
                                        {% for field_data_id, field_data_data in field_data.fieldDataObjects %}
                                            <option value="{{ field_data_id }}"
                                                    {% if mybb.input[field_data.field_key][field_data_id] is not empty %}selected="selected"{% endif %}>{{ field_data_data.value }}</option>
                                        {% endfor %}
                                    </select>
                                {% endif %}
                                {% if field_data.html_type in ['text', 'search', 'textarea'] and field_data.enable_editor %}
                            </div>
                            {% endif %}
                            {% if field_data.html_type in ['text', 'search', 'textarea'] and field_data.enable_editor %}
                                {{ field_data.editorSmilesInserter|raw }}
                            {% endif %}
                        </div>

                        {% if field_data.html_type in ['text', 'search', 'textarea'] and field_data.enable_editor %}
                            {{ field_data.editorCodeButtons|raw }}
                        {% endif %}
                    </div>
                {% endfor %}

                <div class="row row--form field">
                    <h3 class="field__name visually-hidden"><label for="message">{{ lang.your_message }}</label>
                    </h3>
                    <div class="compose__container">
                        <div class="compose__message">
                            <div class="compose__option-buttons">
                                <button type="submit" name="preview" value="preview"
                                        class="button button--basic" form="contentForm">
                                    {{ include('partials/icon.twig', {icon: 'edit', class: 'button__icon'}, with_context = false) }}
                                    <span class="button__text">{{ lang.myShowcaseNewEditFormButtonPreviewEntry }}</span>
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </section>
        </div>
        <div class="form__submit">
            <button type="submit" class="button button--big" name="submit" tabindex="3" accesskey="s"
                    form="contentForm">
                {{ include('partials/icon.twig', {icon: 'comment', class: 'button__icon'}, with_context = false) }}
                <span class="button__text">
                        {% if isEditPage %}
                            {{ lang.myShowcaseNewEditFormButtonUpdateEntry }}
                        {% else %}
                            {{ lang.myShowcaseNewEditFormButtonCreateEntry }}
                        {% endif %}
                    </span>
            </button>
        </div>

        <input type="hidden" name="my_post_key" value="{{ mybb.post_code }}" form="contentForm"/>
        <input type="hidden" name="post_hash" value="{{ mybb.input['post_hash'] }}" form="contentForm"/>
    </div>
{% endblock body %}