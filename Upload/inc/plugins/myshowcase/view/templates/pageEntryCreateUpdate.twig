{% extends 'layouts/master.twig' %}

{% block head %}
    <title>{{ trans('myshowcase_create_update_entry_title_create', config.name) }}
        - {{ mybb.settings.bbname }}</title>
    <link rel="manifest" href="/manifest.json">
{% endblock head %}

{% block jscripts %}
    <link rel="stylesheet" href="{{ mybb.asset_url }}/jscripts/select2/select2.css?ver=1807"/>
    <script type="text/javascript"
            src="{{ mybb.asset_url }}/jscripts/select2/select2.min.js?ver=1806"></script>

    <!-- Include FilePond and plugins -->
    <script src="https://unpkg.com/filepond/dist/filepond.js"></script>
    <script src="https://unpkg.com/filepond-plugin-file-encode/dist/filepond-plugin-file-encode.js"></script>
    <script src="https://unpkg.com/filepond-plugin-file-metadata/dist/filepond-plugin-file-metadata.js"></script>
    <script src="https://unpkg.com/filepond-plugin-file-poster/dist/filepond-plugin-file-poster.js"></script>
    <script src="https://unpkg.com/filepond-plugin-file-validate-size/dist/filepond-plugin-file-validate-size.js"></script>
    <script src="https://unpkg.com/filepond-plugin-image-crop/dist/filepond-plugin-image-crop.js"></script>
    <script src="https://unpkg.com/filepond-plugin-image-exif-orientation/dist/filepond-plugin-image-exif-orientation.js"></script>
    <script src="https://unpkg.com/filepond-plugin-image-preview/dist/filepond-plugin-image-preview.js"></script>
    <script src="https://unpkg.com/filepond-plugin-image-resize/dist/filepond-plugin-image-resize.js"></script>
    <script src="https://unpkg.com/filepond-plugin-image-transform/dist/filepond-plugin-image-transform.js"></script>
    <script src="https://unpkg.com/filepond-plugin-image-validate-size/dist/filepond-plugin-image-validate-size.js"></script>

    <link href="https://unpkg.com/filepond/dist/filepond.css" rel="stylesheet">
    <link
            href="https://unpkg.com/filepond-plugin-file-poster/dist/filepond-plugin-file-poster.css"
            rel="stylesheet"
    />
    <link href="https://unpkg.com/filepond-plugin-image-preview/dist/filepond-plugin-image-preview.css"
          rel="stylesheet">
{% endblock jscripts %}

{% block body %}
    <div class="page-content">
        <header class="page-header">
            <h1 class="title title--page">{{ lang.myshowcase_new_edit_form_title }}</h1>
            <p class="page-description">{{ lang.myshowcase_new_edit_form_title_description }}</p>
        </header>

        {# Forum rules #}
        {% if config.rules_type > 1 and config.rules_content %}
            <section class="container container--forum-rules">
                {% if config.rules_type == 3 %}
                    {# Only http, https and relative links become links: any other scheme (javascript:, data:, ...) is shown as plain text. #}
                    {% set rules_link_is_safe = config.rules_content matches '/^[\\x00-\\x20]*https?:/i' or not (config.rules_content matches '/^[\\x00-\\x20]*[a-z][^:\\/?#]*:/i') %}
                    <strong>
                        {% if rules_link_is_safe %}<a href="{{ config.rules_content }}">{{ config.rules_title|default(trans('forum_rules', config.name)) }}</a>{% else %}{{ config.rules_title|default(trans('forum_rules', config.name)) }}{% endif %}
                    </strong>
                {% else %}
                    <h4 class="title title--container">{{ config.rules_title|default(trans('forum_rules', config.name)) }}</h4>
                    {{ config.rules_content }}
                {% endif %}
            </section>
        {% endif %}

        {% if is_preview_page %}
            <section class="block block--container">
                <h1 class="title title--major title--separation">{{ lang.myshowcase_new_edit_entry_preview }}</h1>
                <div id="posts_container">
                    <div id="posts">
                        {{ entry_preview|raw }}
                    </div>
                </div>
            </section>
        {% endif %}
        {{ error_messages|raw }}
        <form action="{{ config.showcase_url }}{{ url.crate_update }}" method="post"
              enctype="multipart/form-data" name="input" id="contentForm"></form>
        <div class="block block--form form form--compose compose">
            <input type="checkbox" class="compose__checkbox" id="show-post-options" name="show_options"
                   form="contentForm" {{ mybb.input.show_options is defined ? 'checked="checked"' }}/>
            <input type="checkbox" class="compose__checkbox"
                   id="show-attachments"{{ config.attachments_allow_in_entries and entry.attachments.count()|length > 0 ? 'checked="checked"' }}>
            <section class="section section--form compose__primary-section">

                {% if config.entries_enable_subject %}
                    <div class="row row--form field">
                        <h3 class="field__name visually-hidden"><label
                                    for="subject">{{ lang.myshowcase_new_edit_form_entry_subject }}</label></h3>
                        <div class="compose__subject">
                            <input type="text" class="textbox textbox--subject" name="subject" maxlength="120"
                                   id="subject"
                                   placeholder="{{ lang.myshowcase_new_edit_form_entry_subject_placeholder }}"
                                   value="{{ mybb.input.subject is defined ? mybb.input.subject }}" tabindex="1"
                                   form="contentForm"/>
                        </div>
                    </div>
                {% endif %}

                {% if config.entries_allow_post_icons and post_icons is not empty %}
                    {% include '@ext.myshowcase/pageEntryCreateUpdatePostIcons.twig' %}
                {% endif %}

                {% for field_data in entry.getFields() %}
                    {% if field_data.isViewableInForm() %}
                        {% include '@ext.myshowcase/pageEntryCreateUpdateField.twig' %}
                    {% endif %}
                {% endfor %}

                <div class="row row--form field">
                    <h3 class="field__name visually-hidden">
                        <label for="message">{{ lang.myshowcase_create_update_entry_your_message }}</label>
                    </h3>
                    <div class="compose__container">
                        <div class="compose__message">

                            {% if config.entries_enable_message %}
                                <textarea name="message" id="message" rows="20" cols="70" tabindex="2"
                                          form="contentForm">{{ mybb.input.message is defined ? mybb.input.message }}</textarea>
                                {{ code_buttons|raw }}

                                {% if multi_quote %}
                                    <div id="multiquote_unloaded">
                                        <span class="smalltext">
                                            {% if external_quotes == 1 %}
                                                {{ lang.myshowcase_new_edit_form_entry_multi_quote_singular }}
                                            {% else %}
                                                {{ trans('myshowcase_new_edit_form_entry_multi_quote_plural', external_quotes) }}
                                            {% endif %}
                                            <a href="./entry.php?fid={{ config.showcase_id }}&amp;load_all_quotes=1"
                                               onclick="return Post.loadMultiQuotedAll();">{% if external_quotes == 1 %}{{ lang.myshowcase_new_edit_form_entry_multi_quote_plus_singular }}{% else %}{{ trans('myshowcase_new_edit_form_entry_multi_quote_plus_plural', external_quotes) }}{% endif %}</a>,
                                            <a href="javascript:void(0)"
                                               onclick="Post.clearMultiQuoted(); return false;">{% if external_quotes == 1 %}{{ lang.myshowcase_new_edit_form_entry_multi_quote_deselect_singular }}{% else %}{{ lang.myshowcase_new_edit_form_entry_multi_quote_deselect_plural }}{% endif %}</a>
                                        </span>
                                    </div>
                                {% endif %}
                            {% endif %}

                            <div class="compose__option-buttons">
                                {% if (mybb.usergroup.canusesig and mybb.user.suspendsignature) or config.parser_allow_smiles_in_entries %}
                                    <label for="show-post-options"
                                           class="button button--basic compose__option-button--options">
                                        {{ include('partials/icon.twig', {icon: 'cog', class: 'button__icon'}, with_context = false) }}
                                        <span class="button__text">{{ lang.options }}</span>
                                    </label>
                                {% endif %}

                                {% if config.attachments_allow_in_entries %}
                                    <label for="show-attachments"
                                           class="button button--basic compose__option-button--attachments">
                                        {{ include('partials/icon.twig', {icon: 'paperclip', class: 'button__icon'}, with_context = false) }}
                                        <span class="button__text">{{ lang.upload_attachments }}</span>
                                    </label>
                                {% endif %}

                                {% if mybb.user.uid %}
                                    <button type="submit" name="is_draft" value="1" class="button button--basic">
                                        {{ include('partials/icon.twig', {icon: 'file', class: 'button__icon'}, with_context = false) }}
                                        <span class="button__text">{{ lang.save_draft }}</span>
                                    </button>
                                {% endif %}

                                <button type="submit" name="preview" value="preview" class="button button--basic"
                                        form="contentForm">
                                    {{ include('partials/icon.twig', {icon: 'comment-dots', class: 'button__icon'}, with_context = false) }}
                                    <span class="button__text">{{ lang.myshowcase_new_edit_form_button_preview_entry }}</span>
                                </button>
                            </div>
                        </div>

                        {% if config.entries_enable_message %}
                            {{ smiles_inserter|raw }}
                        {% endif %}
                    </div>
                </div>
            </section>

            {% if (mybb.usergroup.canusesig and mybb.user.suspendsignature) or config.parser_allow_smiles_in_entries %}
                <section
                        class="section section--form section--has-title compose__hidden-section compose__hidden-section--options">
                    <h2 class="title title--section">{{ lang.myshowcase_create_update_entry_post_options }}</h2>
                    <div class="section__container">
                        <div class="row row--form field">
                            {% if mybb.usergroup.canusesig and mybb.user.suspendsignature %}
                                <p class="option-field option-field--compact">
                                    <label>
                                        <input type="checkbox" class="checkbox" name="allow_signature" value="1"
                                               tabindex="7" form="contentForm"
                                                {{ mybb.input.allow_signature is defined and mybb.input.allow_signature == 1  ? 'checked="checked"' }} />
                                        <strong>{{ lang.myshowcase_create_update_entry_post_options_signature }}</strong>{{ lang.myshowcase_create_update_entry_post_options_signature_description }}
                                    </label>
                                </p>
                            {% endif %}
                            {% if config.parser_allow_smiles_in_entries %}
                                <p class="option-field option-field--compact">
                                    <label>
                                        <input type="checkbox" class="checkbox" name="$disable_smilies" value="1"
                                               tabindex="9" form="contentForm"
                                                {{ mybb.input.disable_smilies is defined and mybb.input.disable_smilies == 1  ? 'checked="checked"' }} />
                                        <strong>{{ lang.myshowcase_create_update_entry_post_options_disable_smilies }}</strong>{{ lang.myshowcase_create_update_entry_post_options_disable_smilies_description }}
                                    </label>
                                </p>
                            {% endif %}
                        </div>
                    </div>
                </section>
            {% endif %}
            {% if show_moderator_options %}
                <section
                        class="section section--form section--has-title compose__hidden-section compose__hidden-section--options">
                    <h2 class="title title--section">{{ lang.myshowcase_entry_create_update_options_moderator }}</h2>
                    <div class="section__container">
                        <div class="row row--form field">
                            {% if permissions.entries_can_close %}
                                <p class="option-field option-field--compact">
                                    <label>
                                        <input type="checkbox" class="checkbox" name="is_closed"
                                               value="1"{{ not moderator_options.is_closed is empty ? 'checked="checked"' }}
                                               form="contentForm"/>
                                        <strong>{{ lang.myshowcase_entry_create_update_options_moderator_close }}</strong> {{ lang.myshowcase_entry_create_update_options_moderator_close_description }}
                                    </label>
                                </p>
                            {% endif %}
                            {% if permissions.entries_can_sticky %}
                                <p class="option-field option-field--compact">
                                    <label>
                                        <input type="checkbox" class="checkbox" name="is_sticky"
                                               value="1"{{ not moderator_options.is_sticky is empty ? 'checked="checked"' }}
                                               form="contentForm"/>
                                        <strong>{{ lang.myshowcase_entry_create_update_options_moderator_close_stick }}</strong> {{ lang.myshowcase_entry_create_update_options_moderator_close_stick_description }}
                                    </label>
                                </p>
                            {% endif %}
                        </div>
                    </div>
                </section>
            {% endif %}

            {% if mybb.user.uid %}
                {% include '@ext.myshowcase/pageEntryCreateUpdateSubscription.twig' %}
            {% endif %}

            {{ permissions.main_require_captcha ? captcha|raw }}

            {% if config.attachments_allow_in_entries %}
                {% include '@ext.myshowcase/pageEntryCreateUpdateAttachments.twig' %}
            {% endif %}

            <div class="block__footer">
                <button type="submit" class="button button--big" name="submit" tabindex="3" accesskey="s"
                        form="contentForm">
                    {{ include('partials/icon.twig', {icon: 'edit', class: 'button__icon'}, with_context = false) }}
                    <span class="button__text">
                            {{ is_update_page ? lang.myshowcase_new_edit_form_button_update_entry : lang.myshowcase_new_edit_form_button_create_entry }}
                    </span>
                </button>
            </div>
        </div>

        <input type="hidden" name="my_post_key" value="{{ mybb.post_code }}" form="contentForm"/>
        <input type="hidden" name="post_hash" value="{{ mybb.input.post_hash is defined ? mybb.input.post_hash }}"
               form="contentForm"/>
    </div>
    {{ attachmentsUpload|raw }}



{% endblock body %}