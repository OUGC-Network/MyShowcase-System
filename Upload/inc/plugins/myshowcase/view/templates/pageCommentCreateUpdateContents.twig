{{ commentPreview|raw }}
<table border="0" cellspacing="{{ theme.borderwidth }}" cellpadding="{{ theme.tablespace }}" class="tborder">
    <thead>
    <tr>
        <td class="thead" colspan="2">
            <div><strong>{{ lang.myshowcase_view_entry_comment_form_title }}</strong></div>
        </td>
    </tr>
    </thead>
    <tbody>
    <tr>
        <td class="{{ background_class }}" valign="top" width="22%">
            <strong>{{ lang.myShowcaseCommentCreateMessage }}</strong><br/>
            <span class="smalltext">{{ lang.myShowcaseCommentCreateMessageNote }}</span>
        </td>
        <td class="{{ background_class }}">
            <div style="width: 95%">
                <label for="comment"></label>
                <textarea style="width: 100%; padding: 4px; margin: 0;" rows="8" cols="80" name="message" id="comment"
                          tabindex="1"
                          form="contentForm">{% if mybb.input.message is defined %}{{ mybb.input.message }}{% endif %}</textarea>
                {{ code_buttons|raw }}
            </div>
            <div class="editor_control_bar" style="width: 95%; padding: 4px; margin-top: 3px;">
						<span class="smalltext">
                            {{ trans('myshowcase_comment_text_limit', config.comments_message_minimum_length|my_number_format, config.comments_message_minimum_length|my_number_format) }}
						</span>
            </div>
        </td>
    </tr>
    </tbody>
</table>
<br/>
<div align="center">
    <input type="submit" class="button" name="submit" value="{{ buttonText }}" tabindex="3" accesskey="s"
           form="contentForm"/>
    <input type="submit" class="button" name="preview" value="{{ lang.myshowcase_view_entry_comment_form_preview }}"
           tabindex="3" accesskey="s" form="contentForm"/>
</div>
<input type="hidden" name="my_post_key" value="{{ mybb.post_code }}" form="contentForm"/>
<input type="hidden" name="post_hash" value="{{ comment_data.post_hash }}" form="contentForm"/>
<form action="{{ url.create_comment }}" method="post"
      enctype="multipart/form-data" name="input" id="contentForm"></form>
{{ attachmentsUpload|raw }}