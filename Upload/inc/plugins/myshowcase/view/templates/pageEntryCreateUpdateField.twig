<div class="row row--form field">
    <h3 class="field__name visually-hidden">
        <label for="{{ field_data.field_definition.field_key }}">{{ field_data.field_definition.field_label }}</label>
    </h3>
    {% if field_data.field_definition.description is not empty %}
        <p class="field__description">{{ field_data.field_definition.description }}</p>
    {% endif %}
    <div class="{% if field_data.field_definition.enable_subject %}compose__subject{% else %}compose__container{% endif %}">
        {% if field_data.field_definition.html_type in ['text', 'search', 'textarea'] and field_data.field_definition.enable_editor %}
        <div class="compose__message compose__{{ field_data.field_definition.field_key }}">
            {% endif %}
            {% if field_data.field_definition.html_type == 'checkbox' %}
                <div id="{{ field_data.field_definition.field_key }}">
                    {% for field_data_id, field_data_data in field_data.getSelectableValues() %}
                        <p class="option-field option-field--compact">
                            <label>
                                <input type="checkbox"
                                       name="{{ field_data.field_definition.field_key }}"
                                       value="{{ field_data_id }}"
                                       tabindex="{{ loop.index + 10 }}"
                                       form="contentForm"
                                       {% if field_data.field_definition.read_only %}readonly="readonly"{% endif %}
                                        {% if field_data.field_definition.is_required %}required="required"{% endif %}
                                        {% if entry_data.extra_data[field_data.field_definition.field_key] is defined and entry_data.extra_data[field_data.field_definition.field_key] == field_data_id %}checked="checked"{% endif %}
                                />
                                {{ field_data_data.value }}
                            </label>
                        </p>
                    {% endfor %}
                </div>
                {% elseif field_data.field_definition.html_type == 'color' %}
            <input type="color"
                   name="{{ field_data.field_definition.field_key }}"
                   value="{% if entry_data.extra_data[field_data.field_definition.field_key] is defined %}{{ entry_data.extra_data[field_data.field_definition.field_key] }}{% endif %}"
                   tabindex="{{ loop.index + 10 }}"
                   autocomplete="color"
                   class="textbox {% if field_data.field_definition.enable_subject %}textbox--subject{% endif %}"
                   id="{{ field_data.field_definition.field_key }}"
                   form="contentForm"
                   {% if field_data.field_definition.read_only %}readonly="readonly"{% endif %}
                    {% if field_data.field_definition.is_required %}required="required"{% endif %}
                    {% if field_data.field_definition.input_pattern %}pattern="{{ field_data.field_definition.input_pattern }}"{% endif %}
            />
                {% elseif field_data.field_definition.html_type == 'date' %}
            <input type="date"
                   name="{{ field_data.field_definition.field_key }}"
                   value="{% if entry_data.extra_data[field_data.field_definition.field_key] is defined %}{{ entry_data.extra_data[field_data.field_definition.field_key] }}{% endif %}"
                   tabindex="{{ loop.index + 10 }}"
                   autocomplete="date"
                   class="textbox {% if field_data.field_definition.enable_subject %}textbox--subject{% endif %}"
                   id="{{ field_data.field_definition.field_key }}"
                   form="contentForm"
                   {% if field_data.field_definition.read_only %}readonly="readonly"{% endif %}
                    {% if field_data.field_definition.is_required %}required="required"{% endif %}
                    {% if field_data.field_definition.minimum_length %}min="{{ field_data.field_definition.minimum_length }}"{% endif %}
                    {% if field_data.field_definition.maximum_length %}max="{{ field_data.field_definition.maximum_length }}"{% endif %}
                    {% if field_data.step_size %}step="{{ field_data.step_size }}"{% endif %}
                    {% if field_data.field_definition.input_pattern %}pattern="{{ field_data.field_definition.input_pattern }}"{% endif %}
            />
                {% elseif field_data.field_definition.html_type == 'datetime-local' %}
            <input type="datetime-local"
                   name="{{ field_data.field_definition.field_key }}"
                   value="{% if entry_data.extra_data[field_data.field_definition.field_key] is defined %}{{ entry_data.extra_data[field_data.field_definition.field_key] }}{% endif %}"
                   tabindex="{{ loop.index + 10 }}"
                   autocomplete="datetime-local"
                   class="textbox {% if field_data.field_definition.enable_subject %}textbox--subject{% endif %}"
                   id="{{ field_data.field_definition.field_key }}"
                   form="contentForm"
                   {% if field_data.field_definition.read_only %}readonly="readonly"{% endif %}
                    {% if field_data.field_definition.is_required %}required="required"{% endif %}
                    {% if field_data.field_definition.minimum_length %}min="{{ field_data.field_definition.minimum_length }}"{% endif %}
                    {% if field_data.field_definition.maximum_length %}max="{{ field_data.field_definition.maximum_length }}"{% endif %}
                    {% if field_data.step_size %}step="{{ field_data.step_size }}"{% endif %}
                    {% if field_data.field_definition.input_pattern %}pattern="{{ field_data.field_definition.input_pattern }}"{% endif %}
            />
                {% elseif field_data.field_definition.html_type == 'email' %}
            <input type="email"
                   name="{{ field_data.field_definition.field_key }}"
                   value="{% if entry_data.extra_data[field_data.field_definition.field_key] is defined %}{{ entry_data.extra_data[field_data.field_definition.field_key] }}{% endif %}"
                   tabindex="{{ loop.index + 10 }}"
                   autocomplete="email"
                   inputmode="email"
                   class="textbox {% if field_data.field_definition.enable_subject %}textbox--subject{% endif %}"
                   id="{{ field_data.field_definition.field_key }}"
                   form="contentForm"
                   {% if field_data.field_definition.read_only %}readonly="readonly"{% endif %}
                    {% if field_data.field_definition.placeholder %}placeholder="{{ field_data.field_definition.placeholder }}"{% endif %}
                    {% if field_data.field_definition.is_required %}required="required"{% endif %}
                    {% if field_data.field_definition.allow_multiple_values %}multiple="multiple"{% endif %}
                    {% if field_data.field_definition.minimum_length %}minlength="{{ field_data.field_definition.minimum_length }}"{% endif %}
                    {% if field_data.field_definition.maximum_length %}maxlength="{{ field_data.field_definition.maximum_length }}"{% endif %}
                    {% if field_data.field_definition.input_size %}size="{{ field_data.field_definition.input_size }}"{% endif %}
                    {% if field_data.field_definition.input_pattern %}pattern="{{ field_data.field_definition.input_pattern }}"{% endif %}
            />
                {% elseif field_data.field_definition.html_type == 'file' %}
            <input type="file"
                   name="{{ field_data.field_definition.field_key }}"
                   value="{% if entry_data.extra_data[field_data.field_definition.field_key] is defined %}{{ entry_data.extra_data[field_data.field_definition.field_key] }}{% endif %}"
                   tabindex="{{ loop.index + 10 }}"
                   class="textbox"
                   id="{{ field_data.field_definition.field_key }}"
                   form="contentForm"
                   {% if field_data.field_definition.read_only %}readonly="readonly"{% endif %}
                    {% if field_data.extra_data.accept_element %}accept="{{ field_data.extra_data.accept_element }}"{% endif %}
                    {% if field_data.field_definition.file_capture == 1 %}capture="user"{% endif %}
                    {% if field_data.field_definition.file_capture == 2 %}capture="environment"{% endif %}
                    {% if field_data.field_definition.is_required %}required="required"{% endif %}
                    {% if field_data.field_definition.allow_multiple_values %}multiple="multiple"{% endif %}
            />
                <script>
                    FilePond.registerPlugin(
                        FilePondPluginFileEncode,
                        FilePondPluginFileMetadata,
                        FilePondPluginFilePoster,
                        FilePondPluginFileValidateSize,
                        //FilePondPluginFileValidateType,
                        FilePondPluginImageCrop,
                        FilePondPluginImageExifOrientation,
                        FilePondPluginImagePreview,
                        FilePondPluginImageResize,
                        FilePondPluginImageTransform,
                        FilePondPluginImageValidateSize,
                    );

                    // Create a FilePond instance
                    const pond = FilePond.create(document.querySelector('#{{ field_data.field_definition.field_key }}'), {
                        // Core properties
                        className: 'filepond--my-custom-class',
                        {% if field_data.field_definition.is_required %}
                        required: true,
                        {% endif %}
                        {% if field_data.field_definition.read_only %}
                        disabled: true,
                        captureMethod: null,
                        {% endif %}
                        {% if false %}
                        files: [
                            {% for attachment_id,attachment_data in attachment_objects %}
                            {
                                source: '{{ attachment_data.url }}',
                                options: {
                                    type: 'local',
                                    file: {
                                        name: '{{ attachment_data.attachment_name }}',
                                        size: {{ attachment_data.file_size }},
                                        type: '{{ attachment_data.mime_type }}',
                                        url: '{{ attachment_data.url }}',
                                        id: {{ attachment_data.attachment_id }},
                                        fileId: {{ attachment_data.attachment_id }},
                                    },
                                    metadata: {
                                        id: {{ attachment_data.attachment_id }},
                                        fileId: {{ attachment_data.attachment_id }},
                                        poster: '{{ attachment_data.url }}',
                                        url: '{{ attachment_data.url }}',
                                    }
                                }
                            },
                            {% endfor %}
                        ],
                        {% endif %}
                        allowDrop: true,
                        allowBrowse: true,
                        allowPaste: false,
                        allowMultiple: true,
                        allowReplace: true,
                        allowRevert: true,
                        allowRemove: true,
                        allowProcess: true,
                        allowReorder: false,
                        storeAsFile: false,
                        forceRevert: false,
                        maxFiles: null,
                        maxParallelUploads: 1,
                        checkValidity: true,
                        itemInsertLocation: 'after',
                        itemInsertInterval: 75,
                        fileSizeBase: 1000,
                        credits: [], //https://pqina.nl/filepond/docs/api/instance/properties/#disabling-credits
                        // Drag n' Drop
                        dropOnPage: false,
                        dropOnElement: true,
                        dropValidation: false,
                        ignoredFiles: ['.ds_store', 'thumbs.db', 'desktop.ini'],
                        // Server
                        server: {
                            process: {
                                url: '{{ config.showcase_url }}/{{ url.upload }}&field_key={{ field_data.field_definition.field_key }}',
                                method: 'POST',
                                withCredentials: false,
                                onerror: (response) => {
                                    console.error('Upload error:', response);
                                },
                                onload: (response) => {
                                    // todo, refresh attachment list or mark attachment
                                    console.log(response);

                                    return response; // Return the server response
                                },
                                ondata: (formData) => {
                                    formData.append('my_post_key', '{{ mybb.post_code }}');

                                    return formData;
                                },
                            },
                        },
                        onprocessfile: (error, fileItem) => {
                            if (error) {
                                console.error('Error processing file:', error);
                                return;
                            }

                            console.log('File processed successfully:', fileItem);

                            setTimeout(() => {
                                pond.removeFile(fileItem);
                            }, 1000);
                        },
                        instantUpload: true,
                        chunkUploads: true,
                        chunkForce: false,
                        chunkSize: 5000000,
                        chunkRetryDelays: [500, 1000, 3000],
                        // Labels
                        labelDecimalSeparator: undefined,
                        labelThousandsSeparator: undefined,
                        labelIdle: 'Drag & Drop your files or <span class="filepond--label-action"> Browse </span>',
                        labelInvalidField: 'Field contains invalid files',
                        labelFileWaitingForSize: 'Waiting for size',
                        labelFileSizeNotAvailable: 'Size not available',
                        labelFileLoading: 'Uploading',
                        labelFileLoadError: 'Error during load',
                        labelFileProcessing: 'Uploading',
                        labelFileProcessingComplete: 'Upload complete',
                        labelFileProcessingAborted: 'Error cancelled',
                        labelFileProcessingError: 'Error during upload',
                        labelFileProcessingRevertError: 'Error during revert',
                        labelFileRemoveError: 'Error during remove',
                        labelTapToCancel: 'tap to cancel',
                        labelTapToRetry: 'tap to retry',
                        labelTapToUndo: 'tap to undo',
                        labelButtonRemoveItem: 'Remove',
                        labelButtonAbortItemLoad: 'Abort',
                        labelButtonRetryItemLoad: 'Retry',
                        labelButtonAbortItemProcessing: 'Cancel',
                        labelButtonUndoItemProcessing: 'Undo',
                        labelButtonRetryItemProcessing: 'Retry',
                        labelButtonProcessItem: 'Upload',
                        // SVG Icons
                        //iconRemove: '',
                        //iconProcess: '',
                        //iconRetry: '',
                        //iconUndo: '',
                        // Style
                        //stylePanelLayout: 'integrated',
                        stylePanelAspectRatio: '1:0.5',
                        styleItemPanelAspectRatio: '1:1',

                        {% if false %}
                        // File encode
                        allowFileEncode: true,
                        // File metadata
                        allowFileMetadata: true,
                        fileMetadataObject: {
                            markup: [
                                [
                                    'rect',
                                    {
                                        left: 0,
                                        right: 0,
                                        bottom: 0,
                                        height: '60px',
                                        backgroundColor: 'rgba(0,0,0,.5)',
                                    },
                                ],
                                [
                                    'image',
                                    {
                                        right: '10px',
                                        bottom: '10px',
                                        width: '128px',
                                        height: '34px',
                                        src: './filepond-logo.svg',
                                        fit: 'contain',
                                    },
                                ],
                            ],
                        },
                        onpreparefile: (file, output) => {
                            const img = new Image();
                            img.src = URL.createObjectURL(output);
                            document.body.appendChild(img);
                        },
                        // File poster
                        allowFilePoster: true,
                        filePosterMinHeight: null,
                        filePosterMaxHeight: null,
                        filePosterHeight: null,
                        filePosterFilterItem: () => true,
                        filePosterItemOverlayShadowColor: null,
                        filePosterItemOverlayErrorColor: null,
                        filePosterItemOverlaySuccessColor: null,
                        // File size validation
                        allowFileSizeValidation: true,
                        minFileSize: null,
                        maxFileSize: null,
                        labelMaxFileSizeExceeded: 'File is too large',
                        labelMaxFileSize: 'Maximum file size is {filesize}',
                        labelMaxTotalFileSizeExceeded: 'Maximum total size exceeded',
                        labelMaxTotalFileSize: 'Maximum total file size is {filesize}',
                        //File type validation
                        allowFileTypeValidation: true,
                        acceptedFileTypes: ['*'],
                        labelFileTypeNotAllowed: 'File of invalid type',
                        fileValidateTypeLabelExpectedTypes: 'Expects {allButLastType} or {lastType}',
                        fileValidateTypeLabelExpectedTypesMap: {},
                        fileValidateTypeDetectType: (source, type) =>
                            new Promise((resolve, reject) => {
                                // Do custom type detection here and return with promise

                                resolve(type);
                            }),
                        // Image crop
                        allowImageCrop: true,
                        imageCropAspectRatio: null,
                        // Image EXIF orientation
                        allowImageExifOrientation: true,
                        // Image preview
                        allowImagePreview: true,
                        imagePreviewMinHeight: 44,
                        imagePreviewMaxHeight: 256,
                        imagePreviewHeight: null,
                        imagePreviewMaxFileSize: '1MB',
                        imagePreviewTransparencyIndicator: null,
                        imagePreviewMaxInstantPreviewFileSize: 1000000,
                        imagePreviewMarkupShow: true,
                        // Image resize
                        allowImageResize: true,
                        imageResizeTargetWidth: null,
                        imageResizeTargetHeight: null,
                        imageResizeMode: 'cover',
                        imageResizeUpscale: true,
                        // Image transform
                        allowImageTransform: true,
                        imageTransformOutputMimeType: null,
                        imageTransformOutputQuality: null,
                        imageTransformOutputQualityMode: 'always',
                        imageTransformOutputStripImageHead: true,
                        imageTransformClientTransforms: null,
                        imageTransformVariants: {
                            thumb_medium_: (transforms) => {
                                transforms.resize = {
                                    size: {
                                        width: 384,
                                        height: 384,
                                    },
                                };

                                return transforms;
                            },
                            thumb_small_: (transforms) => {
                                transforms.resize = {
                                    size: {
                                        width: 128,
                                        height: 128,
                                    },
                                };

                                return transforms;
                            },
                        },
                        imageTransformVariantsIncludeDefault: true,
                        imageTransformVariantsDefaultName: null,
                        imageTransformVariantsIncludeOriginal: false,
                        imageTransformVariantsOriginalName: null,
                        imageTransformBeforeCreateBlob: (canvas) =>
                            new Promise((resolve) => {
                                // Do something with the canvas, like drawing some text on it
                                const ctx = canvas.getContext('2d');
                                ctx.font = '48px serif';
                                ctx.fillText('Hello world', 10, 50);

                                // return canvas to the plugin for further processing
                                resolve(canvas);
                            }),
                        imageTransformAfterCreateBlob: (blob) =>
                            new Promise((resolve) => {
                                // do something with the blob, for instance send it to a custom compression alogrithm

                                // return the blob to the plugin for further processing
                                resolve(blob);
                            }),
                        imageTransformCanvasMemoryLimit: 4096,
                        // Image validate size
                        allowImageValidateSize: true,
                        imageValidateSizeMinWidth: 1,
                        imageValidateSizeMaxWidth: 65535,
                        imageValidateSizeMinHeight: 1,
                        imageValidateSizeMaxHeight: 65535,
                        imageValidateSizeLabelFormatError: 'Image type not supported',
                        imageValidateSizeLabelImageSizeTooSmall: 'Image is too small',
                        imageValidateSizeLabelImageSizeTooBig: 'Image is too big',
                        imageValidateSizeLabelExpectedMinSize: 'Minimum size is {minWidth} × {minHeight}',
                        imageValidateSizeLabelExpectedMaxSize: 'Maximum size is {maxWidth} × {maxHeight}',
                        imageValidateSizeMinResolution: null,
                        imageValidateSizeMaxResolution: null,
                        imageValidateSizeLabelImageResolutionTooLow: 'Resolution is too low',
                        imageValidateSizeLabelImageResolutionTooHigh: 'Resolution is too high',
                        imageValidateSizeLabelExpectedMinResolution: 'Minimum resolution is {minResolution}',
                        imageValidateSizeLabelExpectedMaxResolution: 'Maximum resolution is {maxResolution}',
                        imageValidateSizeMeasure: null,
                        {% endif %}
                    });

                </script>


                {% elseif field_data.field_definition.html_type == 'month' %}
            <input type="month"
                   name="{{ field_data.field_definition.field_key }}"
                   value="{% if entry_data.extra_data[field_data.field_definition.field_key] is defined %}{{ entry_data.extra_data[field_data.field_definition.field_key] }}{% endif %}"
                   tabindex="{{ loop.index + 10 }}"
                   autocomplete="month"
                   class="textbox {% if field_data.field_definition.enable_subject %}textbox--subject{% endif %}"
                   id="{{ field_data.field_definition.field_key }}"
                   form="contentForm"
                   {% if field_data.field_definition.read_only %}readonly="readonly"{% endif %}
                    {% if field_data.field_definition.is_required %}required="required"{% endif %}
                    {% if field_data.field_definition.minimum_length %}min="{{ field_data.field_definition.minimum_length }}"{% endif %}
                    {% if field_data.field_definition.maximum_length %}max="{{ field_data.field_definition.maximum_length }}"{% endif %}
                    {% if field_data.step_size %}step="{{ field_data.step_size }}"{% endif %}
                    {% if field_data.field_definition.input_pattern %}pattern="{{ field_data.field_definition.input_pattern }}"{% endif %}
            />
                {% elseif field_data.field_definition.html_type == 'number' %}
            <input type="number"
                   name="{{ field_data.field_definition.field_key }}"
                   value="{% if entry_data.extra_data[field_data.field_definition.field_key] is defined %}{{ entry_data.extra_data[field_data.field_definition.field_key] }}{% endif %}"
                   tabindex="{{ loop.index + 10 }}"
                   autocomplete="number"
                   inputmode="numeric"
                   class="textbox {% if field_data.field_definition.enable_subject %}textbox--subject{% endif %}"
                   id="{{ field_data.field_definition.field_key }}"
                   form="contentForm"
                   {% if field_data.field_definition.read_only %}readonly="readonly"{% endif %}
                    {% if field_data.field_definition.placeholder %}placeholder="{{ field_data.field_definition.placeholder }}"{% endif %}
                    {% if field_data.field_definition.is_required %}required="required"{% endif %}
                    {% if field_data.field_definition.minimum_length %}min="{{ field_data.field_definition.minimum_length }}"{% endif %}
                    {% if field_data.field_definition.maximum_length %}max="{{ field_data.field_definition.maximum_length }}"{% endif %}
                    {% if field_data.step_size %}step="{{ field_data.step_size }}"{% endif %}
                    {% if field_data.field_definition.input_pattern %}pattern="{{ field_data.field_definition.input_pattern }}"{% endif %}
            />
                {% elseif field_data.field_definition.html_type == 'password' %}
            <input type="password"
                   name="{{ field_data.field_definition.field_key }}"
                   value="{% if entry_data.extra_data[field_data.field_definition.field_key] is defined %}{{ entry_data.extra_data[field_data.field_definition.field_key] }}{% endif %}"
                   tabindex="{{ loop.index + 10 }}"
                   autocomplete="password"
                   class="textbox {% if field_data.field_definition.enable_subject %}textbox--subject{% endif %}"
                   id="{{ field_data.field_definition.field_key }}"
                   form="contentForm"
                   {% if field_data.field_definition.read_only %}readonly="readonly"{% endif %}
                    {% if field_data.field_definition.placeholder %}placeholder="{{ field_data.field_definition.placeholder }}"{% endif %}
                    {% if field_data.field_definition.is_required %}required="required"{% endif %}
                    {% if field_data.field_definition.minimum_length %}minlength="{{ field_data.field_definition.minimum_length }}"{% endif %}
                    {% if field_data.field_definition.maximum_length %}maxlength="{{ field_data.field_definition.maximum_length }}"{% endif %}
                    {% if field_data.field_definition.input_size %}size="{{ field_data.field_definition.input_size }}"{% endif %}
                    {% if field_data.field_definition.input_pattern %}pattern="{{ field_data.field_definition.input_pattern }}"{% endif %}
            />
                {% elseif field_data.field_definition.html_type == 'radio' %}
                <div id="{{ field_data.field_definition.field_key }}">
                    {% for field_data_id, field_data_data in field_data.getSelectableValues() %}
                        <p class="option-field option-field--compact">
                            <label>
                                <input type="radio"
                                       name="{{ field_data.field_definition.field_key }}"
                                       value="{{ field_data_id }}"
                                       tabindex="{{ loop.index + 10 }}"
                                       form="contentForm"
                                       {% if field_data.field_definition.read_only %}readonly="readonly"{% endif %}
                                        {% if field_data.field_definition.is_required %}required="required"{% endif %}
                                        {% if entry_data.extra_data[field_data.field_definition.field_key] is defined and entry_data.extra_data[field_data.field_definition.field_key] == field_data_id %}checked="checked"{% endif %}
                                />
                                {{ field_data_data.value }}
                            </label>
                        </p>
                    {% endfor %}
                </div>
                {% elseif field_data.field_definition.html_type == 'range' %}
            <input type="range"
                   name="{{ field_data.field_definition.field_key }}"
                   value="{% if entry_data.extra_data[field_data.field_definition.field_key] is defined %}{{ entry_data.extra_data[field_data.field_definition.field_key] }}{% endif %}"
                   tabindex="{{ loop.index + 10 }}"
                   autocomplete="range"
                   class="textbox {% if field_data.field_definition.enable_subject %}textbox--subject{% endif %}"
                   id="{{ field_data.field_definition.field_key }}"
                   form="contentForm"
                   {% if field_data.field_definition.minimum_length %}min="{{ field_data.field_definition.minimum_length }}"{% endif %}
                    {% if field_data.field_definition.maximum_length %}max="{{ field_data.field_definition.maximum_length }}"{% endif %}
                    {% if field_data.step_size %}step="{{ field_data.step_size }}"{% endif %}
            />
                {% elseif field_data.field_definition.html_type == 'search' %}
            <input type="search"
                   name="{{ field_data.field_definition.field_key }}"
                   value="{% if entry_data.extra_data[field_data.field_definition.field_key] is defined %}{{ entry_data.extra_data[field_data.field_definition.field_key] }}{% endif %}"
                   tabindex="{{ loop.index + 10 }}"
                   autocomplete="search"
                   inputmode="search"
                   class="textbox {% if field_data.field_definition.enable_subject %}textbox--subject{% endif %}"
                   id="{{ field_data.field_definition.field_key }}"
                   form="contentForm"
                   {% if field_data.field_definition.read_only %}readonly="readonly"{% endif %}
                    {% if field_data.field_definition.placeholder %}placeholder="{{ field_data.field_definition.placeholder }}"{% endif %}
                    {% if field_data.field_definition.is_required %}required="required"{% endif %}
                    {% if field_data.field_definition.minimum_length %}minlength="{{ field_data.field_definition.minimum_length }}"{% endif %}
                    {% if field_data.field_definition.maximum_length %}maxlength="{{ field_data.field_definition.maximum_length }}"{% endif %}
                    {% if field_data.field_definition.input_size %}size="{{ field_data.field_definition.input_size }}"{% endif %}
                    {% if field_data.field_definition.input_pattern %}pattern="{{ field_data.field_definition.input_pattern }}"{% endif %}
            />
                {% elseif field_data.field_definition.html_type == 'tel' %}
            <input type="tel"
                   name="{{ field_data.field_definition.field_key }}"
                   value="{% if entry_data.extra_data[field_data.field_definition.field_key] is defined %}{{ entry_data.extra_data[field_data.field_definition.field_key] }}{% endif %}"
                   tabindex="{{ loop.index + 10 }}"
                   autocomplete="tel"
                   inputmode="tel"
                   class="textbox {% if field_data.field_definition.enable_subject %}textbox--subject{% endif %}"
                   id="{{ field_data.field_definition.field_key }}"
                   form="contentForm"
                   {% if field_data.field_definition.read_only %}readonly="readonly"{% endif %}
                    {% if field_data.field_definition.placeholder %}placeholder="{{ field_data.field_definition.placeholder }}"{% endif %}
                    {% if field_data.field_definition.is_required %}required="required"{% endif %}
                    {% if field_data.field_definition.minimum_length %}minlength="{{ field_data.field_definition.minimum_length }}"{% endif %}
                    {% if field_data.field_definition.maximum_length %}maxlength="{{ field_data.field_definition.maximum_length }}"{% endif %}
                    {% if field_data.field_definition.input_size %}size="{{ field_data.field_definition.input_size }}"{% endif %}
                    {% if field_data.field_definition.input_pattern %}pattern="{{ field_data.field_definition.input_pattern }}"{% endif %}
            />
                {% elseif field_data.field_definition.html_type == 'text' %}
            <input type="text"
