<a name="{{ entry_data.public_id }}" id="{{ entry_data.public_id }}"></a>
{# Ignored post #}
{% if is_ignored %}
    <div class="post post--message ignored_post" id="ignored_post_{{ entry_data.public_id }}">
        <div class="post__meta">
            <h3 class="post__author">
                <a href="{{ get_profile_link(user_data.uid) }}">{{ user_data.uid|format_name }}</a>
            </h3>
        </div>
        <div class="post__body post__body--message post_body">
            {{ ignored_message }}
            <div class="post--message__button" id="show_ignored_link_{{ entry_data.public_id }}">
                <a href="javascript:void(0)"
                   onclick="Thread.showIgnoredPost({{ entry_data.public_id }}); return false;"
                   class="button">
                    {{ include('partials/icon.twig', {icon: 'eye', class: 'button__icon'}, with_context = false) }}
                    <span class="button__text">{{ lang.myshowcase_view_entry_button_ignored_deleted_show }}</span>
                </a>
            </div>
            <script type="text/javascript">
                <!--
                $('#show_ignored_link_{{ entry_data.public_id }}').show();
                // -->
            </script>
        </div>
    </div>
{% endif %}

{# Deleted post #}
{% if entry_data.status == 2 and permissions.entries_can_view %}
    <div class="post post--message deleted_post_collapsed" id="deleted_post_{{ entry_data.public_id }}">
        <div class="post__meta">
            <h3 class="post__author">
                <a href="{{ get_profile_link(user_data.uid) }}">{{ user_data.uid|format_name }}</a>
            </h3>
        </div>
        <div class="post__body post__body--message post_body" id="deleted_post{{ entry_data.public_id }}">
            {{ trans(lang.myshowcase_view_entry_deleted_user, user_data.username) }}
            <div class="post--message__button" id="show_deleted_link_{{ entry_data.public_id }}">
                <a href="javascript:void(0)"
                   onclick="Thread.showDeletedPost({{ entry_data.public_id }}); return false;"
                   class="button">
                    {{ include('partials/icon.twig', {icon: 'eye', class: 'button__icon'}, with_context = false) }}
                    <span class="button__text">{{ lang.myshowcase_view_entry_button_ignored_deleted_show }}</span>
                </a>
            </div>
            <script type="text/javascript">
                <!--
                $('#show_deleted_link_{{ entry_data.public_id }}').show();
                // -->
            </script>
        </div>
    </div>
{% endif %}

{# Deleted post #}
{% if entry_data.extra_data.is_deleted %}
    <div class="post post--message deleted_entry_collapsed" id="deleted_entry_{{ entry_data.public_id }}">
        <div class="post__meta">
            <h3 class="post__author">
                <a href="{{ get_profile_link(user_data.uid) }}">{{ user_data.uid|format_name }}</a>
            </h3>
        </div>
        <div class="post__body post__body--message post_body" id="deleted_post{{ entry_data.public_id }}">
            {{ deletedMessage }}
            <div class="post--message__button" id="show_deleted_link_{{ entry_data.public_id }}">
                <a href="javascript:void(0)"
                   onclick="Showcase.showDeletedEntry('{{ entry_data.public_id }}'); return false;"
                   class="button">
                    {{ include('partials/icon.twig', {icon: 'eye', class: 'button__icon'}, with_context = false) }}
                    <span class="button__text">{{ lang.myshowcase_view_entry_button_ignored_deleted_show }}</span>
                </a>
            </div>
            <script type="text/javascript">
                <!--
                $('#show_deleted_link_{{ entry_data.public_id }}').show();
                // -->
            </script>
        </div>
    </div>
{% endif %}

{# Post bit #}
<div class="post {{ unapproved_class }}" style="{{ style_visibility }}" id="entryBody{{ entry_data.public_id }}">
    <div class="post__meta">
        {# Author avatar #}
        {% if config.entries_display_avatars and mybb.user.showavatars is defined and mybb.user.showavatars is not empty and user_avatar %}
            <a href="{{ get_profile_link(user_data.uid) }}" class="avatar-profile-link">
                {% if user_data.avatar %}
                    <img src="{{ user_avatar.image }}" alt="" {{ user_avatar.width_height|raw }} class="avatar"/>
                {% else %}
                    {% include 'partials/default_avatar.twig' %}
                {% endif %}
            </a>
        {% endif %}

        {# Author username #}
        <h3 class="post__author">
            <a href="{{ get_profile_link(user_data.uid) }}">{{ user_data.uid|format_name }}</a>
            {# Online status #}
            {% if userOnlineStatus == 'online' %}
                <span class="user-status user-status--online">
                    <a href="{{ mybb.settings.bburl }}/online.php"
                       title="{{ lang.myshowcase_view_entry_status_online }}"
                       class="user-status__link">
                        {{ include('partials/icon.twig', {icon: 'dot-circle', class: 'user-status__icon', title: lang.myshowcase_view_entry_status_online}, with_context = false) }}
                    </a>
                </span>
            {% elseif userOnlineStatus == 'away' %}
                <span class="user-status user-status--away">
    <a href="{{ get_profile_link(user_data.uid) }}" title="{{ lang.myshowcase_view_entry_status_away }}"
       class="user-status__link">
        {{ include('partials/icon.twig', {icon: 'dot-circle', class: 'user-status__icon', title: lang.myshowcase_view_entry_status_away}, with_context = false) }}
    </a>
</span>
            {% else %}
                <span class="user-status user-status--offline">
    {{ include('partials/icon.twig', {icon: 'dot-circle', class: 'user-status__icon', title: lang.myshowcase_view_entry_status_offline}, with_context = false) }}
</span>
            {% endif %}
        </h3>

        {# Post icon #}
        {% if config.entries_allow_post_icons and entry_data.icon_id and icons_cache[entry_data.icon_id] is defined %}
            <img src="{{ mybb.settings.bburl }}/{{ icons_cache[entry_data.icon_id].path }}"
                 alt="{{ icons_cache[entry_data.icon_id].name }}" title="{{ icons_cache[entry_data.icon_id].name }}"
                 style="vertical-align: middle;"/>&nbsp;
        {% endif %}

        {# Entry date & permalink #}
        <a href="{{ config.showcase_url }}{{ url.entry }}#{{ entry_data.public_id }}"
           title="{{ entry_data.dateline.getTimestamp()|striptags }}"
           class="post__date">
            {{ entry_data.dateline|date }}
        </a>

        {# Inline moderation checkbox #}
        {% if not is_preview and permissions.entries_can_view %}
            <label for="inlinemod_{{ entry_data.public_id }}"></label>
            <input type="checkbox" class="checkbox post__inline-mod" name="inlinemod_{{ entry_data.public_id }}"
                   id="inlinemod_{{ entry_data.public_id }}" value="1"
                   {% if entry_data.extra_data.moderator_check %}checked="checked"{% endif %}/>
        {% endif %}

        {% if show_edited_message %}
            <a href="#" class="post__edit-log" title=""
               id="edited_by_{{ entry_data.public_id }}">{{ include('partials/icon.twig', {icon: 'pencil-alt', class: ''}, with_context = false) }}</a>
            <span class="post__edit-reason">({{ trans('myshowcase_view_entry_edited_note', entry_data.update_dateline|my_date) }} <a
                        href="{{ get_profile_link(entry_data.extra_data.edit_user_data.uid) }}">{{ entry_data.extra_data.edit_user_data.username }}</a>.{% if entry_data.update_note %}
                <em>{{ lang.postbit_editreason }}: {{ entry_data.update_note }}</em>{% endif %})</span>
        {% endif %}

        {# IP address #}
        {% if not is_preview and entry_data.extra_data.show_ip %}
            {{ lang.postbit_ipaddress }} {{ entry_data.extra_data.ip_address }}
        {% elseif not is_preview and entry_data.extra_data.hide_ip %}
            <a href="/getip/{{ entry_data.public_id }}"
               onclick="MyBB.getIP('{{ entry_data.public_id }}'); return false;" class="post__ip-address">
                {{ include('partials/icon.twig', {icon: 'globe', class: 'button__icon', title: lang.postbit_ipaddress}, with_context = false) }}
            </a>
        {% endif %}
    </div>

    {# Post body #}
    <div class="post__body post_body scaleimages" id="pid_{{ entry_data.public_id }}">
        {# Post unapproved or deleted message #}
        {% if not is_preview and (entry_data.status == 0 or entry_data.status == 2) %}
            <div class="post__status">
                <span class="tag tag--post-status{% if entry_data.extra_data.is_deleted %} tag--deleted{% endif %}{% if entry_data.status == 0 %} tag--awaiting-approval{% endif %}">{{ entry_data.status == 2 ? lang.myshowcase_view_status_deleted : entry_data.status == 1 ? lang.myshowcase_view_status_visible : lang.myshowcase_view_status_awaiting }}</span>
            </div>
        {% endif %}

        {# Entry fields #}
        {% for field_data in entry_data.getFields() %}
            {% if field_data.isViewableInEntry() and (config.entries_display_empty_fields or field_data.getUserValue() is not same as('') or field_data.attachments_rendered is not empty) %}
                {% include '@ext.myshowcase/pageViewEntryField.twig' %}
            {% endif %}
        {% endfor %}

        {# Entry message #}
        {% if config.entries_enable_message %}
            <div class="post__message">
                {{ entry_data.message|raw }}
            </div>
        {% endif %}

        {# Attachments #}
        {{ entry_attachments|raw }}

        {# Signature #}
        {% if user_signature %}
            <div class="post__signature scaleimages">
                {{ user_signature|raw }}
            </div>
        {% endif %}

        {# Edit reason #}
        {% if entry_data.extra_data.can_edit %}
            <div class="editreason" id="editreason_{{ entry_data.public_id }}_original" style="display: none;">
                <label for="quickedit_{{ entry_data.public_id }}_editreason_original">{{ lang.postbit_editreason }}
                    :</label>
                <input type="text" class="textbox" style="margin: 6px 0;" name="editreason" size="40" maxlength="150"
                       id="quickedit_{{ entry_data.public_id }}_editreason_original"
                       value="{{ entry_data.update_note is defined ? entry_data.update_note }}"/><br/>
            </div>
        {% endif %}
    </div>

    {# Post controls #}
    {% if not is_preview %}
        <div class="post__foot post__foot--controls">
            <div class="post-controls post-controls--primary">
                {# Restore button (for deleted posts) #}
                {% if (permissions.entries_can_delete or permissions.entries_can_view) %}
                    <a href="editpost.php?pid={{ entry_data.public_id }}"
                       onclick="Thread.restorePost({{ entry_data.public_id }}); return false;"
                       style="display: none;" id="quick_restore_{{ entry_data.public_id }}"
                       title="{{ lang.myshowcase_view_entry_action_quick_restore_title }}"
                       class="post-control post-control--restore">
                        {{ include('partials/icon.twig', {icon: 'circle', class: 'post-control__icon fa-fw'}, with_context = false) }}
                        <span class="post-control__text">{{ lang.myshowcase_view_entry_action_quick_restore }}</span>
                    </a>
                    <script type="text/javascript">
                        // <!--
                        $('#quick_restore_{{ entry_data.public_id }}').css('display', '{% if entry_data.status != 2 %}none{% endif %}');
                        // -->
                    </script>
                {% endif %}

                {# Reply to post button #}
                {% if entry_data.status == 1 and (permissions.comments_can_post or permissions.can_manage_comments) %}
                    <a href="newreply.php?tid={{ entry_data.public_id }}&amp;replyto={{ entry_data.public_id }}"
                       title="{{ lang.myshowcase_view_entry_action_quote_title }}"
                       class="post-control post-control--reply"><i>{{ include('partials/icon.twig', {icon: 'comments', class: 'post-control__icon fa-fw'}, with_context = false) }}</i><span
                                class="post-control__text">{{ lang.myshowcase_view_entry_action_quote }}</span></a>
                {% endif %}

                {# Multiquote button #}
                {% if entry_data.status == 1 and (permissions.comments_can_post or permissions.can_manage_comments) %}
                    <a href="javascript:void(0)" onclick="Thread.multiQuote({{ entry_data.public_id }}); return false;"
                       style="display: none;" id="multiquote_link_{{ entry_data.public_id }}"
                       title="{{ lang.myshowcase_view_entry_action_multi_quote_title }}"
                       class="postbit_multiquote post-control post-control--quote">
                        {{ include('partials/icon.twig', {icon: 'quote-left', class: 'post-control__icon fa-fw'}, with_context = false) }}
                        <span id="multiquote_{{ entry_data.public_id }}"
                              class="post-control__text">{{ lang.myshowcase_view_entry_action_multi_quote }}</span>
                    </a>
                    <script type="text/javascript">
                        //<!--
                        $('#multiquote_link_{{ entry_data.public_id }}').css("display", "");
                        // -->
                    </script>
                {% endif %}
            </div>
            <div class="post-controls post-controls--secondary post-options">
                {% if entry_data.public_id and permissions.entries_can_update %}
                    <a href="javascript:void(0)"
                       class="post-control post-control--quick-edit quick_edit_button hidden"
                       id="quick_edit_post_{{ entry_data.public_id }}"
                       title="{{ lang.myshowcase_view_entry_action_edit_title }}"
                       data-entry-public-id="{{ entry_data.public_id }}"
                       data-view-url="{{ config.showcase_url }}{{ url.entry_api }}"
                       data-update-url="{{ config.showcase_url }}{{ url.update_api }}">
                        {{ include('partials/icon.twig', {icon: 'pencil-alt', class: 'post-control__icon fa-fw'}, with_context = false) }}
                        <span class="post-control__text">{{ lang.myshowcase_view_entry_action_edit }}</span>
                    </a>
                {% endif %}
                {% if
                    (entry_data.public_id and (
                    permissions.entries_can_update or
                    permissions.entries_can_delete
                    )) or
                    (mybb.user.uid not in entry_data.extra_data.reporters_list and user_permissions.canbereported) or
                    (mybb.usergroup.canwarnusers and user_data.uid != mybb.user.uid) or
                    (show_purge_spammer_button) %}
                    <input type="checkbox" class="post-options__checkbox" id="post_options_{{ entry_data.public_id }}">
                    <label for="post_options_{{ entry_data.public_id }}"
                           class="post-control post-control--options post-options__control"
                           title="{{ lang.myshowcase_view_entry_options }}">
                        {{ include('partials/icon.twig', {icon: 'ellipsis-v', class: 'post-control__icon fa-fw'}, with_context = false) }}
                        <span class="visually-hidden">{{ lang.myshowcase_view_entry_options }}</span>
                    </label>
                    <span class="post-options__list" id="post_options2_{{ entry_data.public_id }}">
                        {# Edit button #}
                        {% if entry_data.public_id and permissions.entries_can_update %}
                            <a href="{{ config.showcase_url }}{{ url.update }}"
                               class="post-control post-control--full-edit">
                            {{ include('partials/icon.twig', {icon: 'edit', class: 'post-control__icon fa-fw'}, with_context = false) }}
                            <span class="post-control__text">{{ lang.myshowcase_view_entry_options_full_edit }}</span>
                        </a>
                        {% endif %}

                        {# Delete button #}
                        {% if entry_data.public_id and permissions.entries_can_soft_delete %}
                            <a href="{{ config.showcase_url }}{{ url.soft_delete }}"
                               onclick="Thread.deletePost({{ entry_data.public_id }}); return false;"
                               style="display: none;"
                               id="quick_delete_{{ entry_data.public_id }}"
                               title="{{ lang.myshowcase_view_entry_options_quick_delete_title }}"
                               class="post-control post-control--delete">
                            {{ include('partials/icon.twig', {icon: 'trash', class: 'post-control__icon fa-fw'}, with_context = false) }}
                            <span class="post-control__text">{{ lang.myshowcase_view_entry_options_quick_delete }}</span>
                        </a>
                            <script type="text/javascript">
    // <!--
    $('#quick_delete_{{ entry_data.public_id }}').css('display', '{% if entry_data.status ==2 %}none{% endif %}');
    // -->
    </script>
                        {% endif %}

                        {# Delete button #}
                        {% if entry_data.public_id and permissions.entries_can_delete %}
                            <a href="{{ config.showcase_url }}{{ url.delete }}"
                               title="{{ lang.myshowcase_view_entry_options_quick_delete_permanently_title }}"
                               class="post-control post-control--delete">
                            {{ include('partials/icon.twig', {icon: 'trash', class: 'post-control__icon fa-fw'}, with_context = false) }}
                            <span class="post-control__text">{{ lang.myshowcase_view_entry_options_quick_delete_permanently }}</span>
                        </a>
                            <script type="text/javascript">
    // <!--
    $('#quick_delete_{{ entry_data.public_id }}').css('display', '{% if entry_data.status ==2 %}none{% endif %}');
    // -->
    </script>
                        {% endif %}

                        {# Report button #}
                        {% if mybb.user.uid not in entry_data.extra_data.reporters_list and user_permissions.canbereported %}
                            <a href="javascript:void(0)"
                               onclick="Report.reportPost({{ entry_data.public_id }}); return false;"
                               title="{{ lang.myshowcase_view_entry_options_report_title }}"
                               class="post-control post-control--report">
                            {{ include('partials/icon.twig', {icon: 'flag', class: 'post-control__icon fa-fw'}, with_context = false) }}
                            <span class="post-control__text">{{ lang.myshowcase_view_entry_options_report }}</span>
                        </a>
                        {% endif %}

                        {# Warn user button #}
                        {% if mybb.usergroup.canwarnusers and user_data.uid != mybb.user.uid %}
                            <a href="{{ mybb.settings.bburl }}/warnings.php?action=warn&amp;uid={{ user_data.uid }}&amp;pid={{ entry_data.public_id }}"
                               title="{{ lang.myshowcase_view_entry_options_warn_title }}"
                               class="post-control post-control--warn">
                            {{ include('partials/icon.twig', {icon: 'exclamation-triangle', class: 'post-control__icon fa-fw'}, with_context = false) }}
                            <span class="post-control__text">{{ lang.myshowcase_view_entry_options_warn }}</span>
                        </a>
                        {% endif %}

                        {# Purge spammer button #}
                        {% if show_purge_spammer_button %}
                            <a href="{{ mybb.settings.bburl }}/moderation.php?action=purgespammer&amp;uid={{ user_data.uid }}"
                               title="{{ lang.myshowcase_view_entry_options_purge_spammer_title }}"
                               class="post-control post-control--purge-spammer">
                            {{ include('partials/icon.twig', {icon: 'gavel', class: 'post-control__icon fa-fw'}, with_context = false) }}
                            <span class="post-control__text">{{ lang.myshowcase_view_entry_options_purge_spammer }}</span>
                        </a>
                        {% endif %}
                </span>
                {% endif %}
            </div>
        </div>
    {% endif %}
</div>