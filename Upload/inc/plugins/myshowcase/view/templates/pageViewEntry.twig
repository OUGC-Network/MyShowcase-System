<a name="{{ entry_data.entry_slug }}" id="{{ entry_data.entry_slug }}"></a>
{# Ignored post #}
{% if entry_data.is_ignored %}
    <div class="ignored_post" id="ignored_entry_{{ entry_data.entry_slug }}">
        <div class="ignored_post_author"><strong><span class="largetext">{{ userProfileLink|raw }}</span></strong></div>
        <div class="ignored_post_message">
            <div class="show_ignored_post float_right" style="vertical-align: top;"
                 id="show_ignored_link_{{ entry_data.entry_slug }}">
                <a href="javascript:void(0)"
                   onclick="Showcase.showIgnoredEntry('{{ entry_data.entry_slug }}'); return false;"
                   class="button small_button">
                    <span>{{ lang.myShowcaseEntryDeletedSButtonShow }}</span>
                </a>
            </div>
            <script type="text/javascript">
                <!--
                $('#show_ignored_link_{{ entry_data.entry_slug }}').show();
                // -->
            </script>
            {{ ignored_message|raw }}
        </div>
    </div>
{% endif %}

{# Deleted post #}
{% if entry_data.is_deleted %}
    <div class="post post--message deleted_entry_collapsed" id="deleted_entry_{{ entry_data.entry_slug }}">
        <div class="post__meta">
            <h3 class="post__author">{{ userProfileLink|raw }}</h3>
        </div>
        <div class="post__body post__body--message post_body" id="deleted_post{{ entry_data.entry_slug }}">
            {{ deletedMessage }}
            <div class="post--message__button" id="show_deleted_link_{{ entry_data.entry_slug }}">
                <a href="javascript:void(0)"
                   onclick="Showcase.showDeletedEntry('{{ entry_data.entry_slug }}'); return false;"
                   class="button">
                    {{ include('partials/icon.twig', {icon: 'eye', class: 'button__icon'}, with_context = false) }}
                    <span class="button__text">{{ lang.myShowcaseEntryDeletedSButtonShow }}</span>
                </a>
            </div>
            <script type="text/javascript">
                <!--
                $('#show_deleted_link_{{ entry_data.entry_slug }}').show();
                // -->
            </script>
        </div>
    </div>
{% endif %}

{# Post bit #}
<div class="post {{ style_class }}" style="{{ style_visibility }}" id="entryBody{{ entry_data.entry_slug }}">
    <div class="post__meta">
        {# Author avatar #}
        {% if mybb.user.showavatars is defined and mybb.user.showavatars is not empty %}
            <a href="{{ userProfileLinkPlain|raw }}" class="avatar-profile-link">
                {% if userData.avatar %}
                    <img src="{{ user_avatar.image }}" alt="" {{ user_avatar.width_height|raw }} class="avatar"/>
                {% else %}
                    {% include 'partials/default_avatar.twig' %}
                {% endif %}
            </a>
        {% endif %}

        {# Author username #}
        <h3 class="post__author">
            {{ userProfileLink|raw }}
            {# Online status #}
            {% if userOnlineStatus == 'online' %}
                <span class="user-status user-status--online">
    <a href="online.php" title="{{ lang.myShowcaseCommentOnlineStatusOnline }}"
       class="user-status__link">
        {{ include('partials/icon.twig', {icon: 'dot-circle', class: 'user-status__icon', title: lang.myShowcaseCommentOnlineStatusOnline}, with_context = false) }}
    </a>
</span>
            {% elseif userOnlineStatus == 'away' %}
                <span class="user-status user-status--away">
    <a href="{{ userProfileLinkPlain|raw }}" title="{{ lang.myShowcaseCommentOnlineStatusAway }}"
       class="user-status__link">
        {{ include('partials/icon.twig', {icon: 'dot-circle', class: 'user-status__icon', title: lang.myShowcaseCommentOnlineStatusAway}, with_context = false) }}
    </a>
</span>
            {% else %}
                <span class="user-status user-status--offline">
    {{ include('partials/icon.twig', {icon: 'dot-circle', class: 'user-status__icon', title: lang.myShowcaseCommentOnlineStatusOffline}, with_context = false) }}
</span>
            {% endif %}
        </h3>

        {# Entry date & permalink #}
        <a href="{{ url.entry }}#{{ entry_data.entry_slug }}" title="{{ entrySubject }}" class="post__date">
            {{ date|my_date }}
        </a>

        {# Inline moderation checkbox #}
        {% if permissions.can_manage_entries %}
            <label for="inlinemod_{{ entry_data.entry_slug }}"></label>
            <input type="checkbox" class="checkbox post__inline-mod" name="inlinemod_{{ entry_data.entry_slug }}"
                   id="inlinemod_{{ entry_data.entry_slug }}" value="1"
                   {% if entry_data.moderator_check %}checked="checked"{% endif %}/>
        {% endif %}

        {% if entry_data.edit_user_id %}
            {# TO DO : CLEAN UP EDITED MESSAGE #}
            <a href="#" class="post__edit-log" title=""
               id="edited_by_{{ entry_data.entry_slug }}">{{ include('partials/icon.twig', {icon:
                    'pencil-alt', class: ''}, with_context = false) }}</a>
            <span class="edited_post"
                  style="display: none;">({{ myShowcaseEntryEditedBy|raw }} <a
                        href="{{ get_profile_link(entry_data.edit_user_id) }}">{{ entry_data.edit_user_id|format_name }}</a>.)</span>

        {% endif %}
    </div>

    {# Post body #}
    <div class="post__body post_body scaleimages" id="pid_{{ entry_data.entry_slug }}">
        {# Post unapproved or deleted message #}
        {% if entry_data.status == 0 or entry_data.status == 2 %}
            <div class="post__status">
                <span class="tag tag--post-status{% if entry_data.is_deleted %} tag--deleted{% endif %}{% if entry_data.status == 0 %} tag--awaiting-approval{% endif %}">{{ entry_data.status }}</span>
            </div>
        {% endif %}

        {# Post message #}
        {% for field_id, field_data in fields_objects %}
            {% include '@ext.myshowcase/pageViewEntryField.twig' %}
        {% endfor %}

        {# Attachments #}
        {{ entryAttachments|raw }}

        {# Signature #}
        {% if userSignature %}
            <div class="post__signature scaleimages">
                {{ userSignature|raw }}
            </div>
        {% endif %}
    </div>

    {# Post controls #}
    <div class="post__foot post__foot--controls">
        <div class="post-controls post-controls--primary">
            {# Restore button (for deleted posts) #}
            {% if false and entry_data.quick_restore %}
                <a href="editentry_data.php?pid={{ entry_data.entry_slug }}"
                   onclick="Thread.restorePost({{ entry_data.entry_slug }}); return false;"
                   id="quick_restore_{{ entry_data.entry_slug }}" title="{{ lang.postbit_quick_restore }}"
                   class="post-control post-control--restore">
                    {{ include('partials/icon.twig', {icon: 'circle', class: 'post-control__icon fa-fw'}, with_context = false) }}
                    <span class="post-control__text">{{ lang.postbit_button_qrestore }}</span>
                </a>
                <script type="text/javascript">
                    // <!--
                    $('#quick_restore_{{ entry_data.entry_slug }}').css('display', '{{ entry_data.quick_restore_display }}');
                    // -->
                </script>
            {% endif %}

            {# Multiquote button #}
            {% if false and entry_data.button_multiquote %}
                <a href="javascript:void(0)" onclick="Thread.multiQuote({{ entry_data.entry_slug }}); return false;"
                   id="multiquote_link_{{ entry_data.entry_slug }}" title="{{ lang.postbit_multiquote }}"
                   class="postbit_multiquote post-control post-control--quote">
                    {{ include('partials/icon.twig', {icon: 'quote-left', class: 'post-control__icon fa-fw'}, with_context = false) }}
                    <span id="multiquote_{{ entry_data.entry_slug }}"
                          class="post-control__text">{{ lang.postbit_button_multiquote }}</span>
                </a>
                <script type="text/javascript">
                    //<!--
                    $('#multiquote_link_{{ entry_data.entry_slug }}').css("display", "");
                    // -->
                </script>
            {% endif %}

            {# Reputation button #}
            {% if false and entry_data.button_rep %}
                <a href="javascript:void(0)"
                   onclick="MyBB.reputation({{ entry_data.uid }}, {{ entry_data.entry_slug }}); return false;"
                   title="{{ lang.postbit_reputation_add }}" class="post-control post-control--rate">
                    {{ include('partials/icon.twig', {icon: 'thumbs-up', class: 'post-control__icon fa-fw'}, with_context = false) }}
                    <span class="post-control__text">{{ lang.postbit_button_reputation_add }}</span>
                </a>
            {% endif %}
        </div>
        <div class="post-controls post-controls--secondary post-options">
            {% if url.update %}
                <a href="{{ url.update }}" class="post-control post-control--quick-edit quick_edit_button"
                   id="quick_edit_entry_{{ entry_data.entry_slug }}"
                   title="{{ lang.myShowcaseCommentButtonEditDescription }}">
                    {{ include('partials/icon.twig', {icon: 'pencil-alt', class: 'post-control__icon fa-fw'}, with_context = false) }}
                    <span class="post-control__text">{{ lang.myShowcaseCommentButtonEdit }}</span>
                </a>
            {% endif %}
            {% if false and (buttonWarn or buttonPurgeSpammer or buttonReport or buttonApprove or buttonUnpprove or buttonRestore or buttonSoftDelete or buttonDelete) %}
                <input type="checkbox" class="post-options__checkbox" id="post_options_{{ entry_data.entry_slug }}">
                <label for="post_options_{{ entry_data.entry_slug }}"
                       class="post-control post-control--options post-options__control"
                       title="{{ lang.postbit_post_options }}">
                    {{ include('partials/icon.twig', {icon: 'ellipsis-v', class: 'post-control__icon fa-fw'}, with_context = false) }}
                    <span class="visually-hidden">{{ lang.postbit_post_options }}</span>
                </label>
                <span class="post-options__list" id="post_options2_{{ entry_data.entry_slug }}">
                {# Edit button #}
                    {% if url_comment_approve %}
                        <form id="approveEntry{{ entry_data.entry_slug }}" action="{{ approveUrl }}" method="post"
                              style="display:none;">
                            <input type="hidden" name="my_post_key" value="{{ mybb.post_code }}"/>
                        </form>
                        <a href="javascript:void(0)"
                           onclick="Showcase.confirmSubmit('{{ lang.myShowcaseEntryButtonApproveConfirm }}', 'approveEntry{{ entry_data.entry_slug }}');"
                           title="{{ lang.myShowcaseEntryButtonApproveDescription }}"
                           class="post-control post-control--delete">
    {{ include('partials/icon.twig', {icon: 'trash', class: 'post-control__icon fa-fw'}, with_context = false) }}
                            <span class="post-control__text">{{ lang.myShowcaseEntryButtonApprove }}</span>
                        </a>
                    {% elseif url_comment_unapprove %}
                        <form id="unapproveEntry{{ entry_data.entry_slug }}" action="{{ unapproveUrl }}" method="post"
                              style="display:none;">
                            <input type="hidden" name="my_post_key" value="{{ mybb.post_code }}"/>
                        </form>
                        <a href="javascript:void(0)" title="{{ lang.myShowcaseEntryButtonUnapproveDescription }}"
                           class="postbit_qdelete"
                           onclick="Showcase.confirmSubmit('{{ lang.myShowcaseEntryButtonUnapproveConfirm }}', 'unapproveEntry{{ entry_data.entry_slug }}');">
                            <span>{{ lang.myShowcaseEntryButtonUnapprove }}</span>
                        </a>
                    {% endif %}

                    {% if url_comment_delete %}
                        <form id="deleteEntry{{ entry_data.entry_slug }}" action="{{ deleteUrl }}" method="post"
                              style="display:none;">
                            <input type="hidden" name="my_post_key" value="{{ mybb.post_code }}"/>
                        </form>
                        <a href="javascript:void(0)"
                           onclick="Showcase.confirmSubmit('{{ lang.myShowcaseEntryButtonDeleteConfirm }}', 'deleteEntry{{ entry_data.entry_slug }}');"
                           id="quick_delete_{{ entry_data.entry_slug }}"
                           title="{{ lang.myShowcaseEntryButtonDeleteDescription }}"
                           class="post-control post-control--delete">
                            {{ include('partials/icon.twig', {icon: 'trash', class: 'post-control__icon fa-fw'}, with_context = false) }}
                            <span class="post-control__text">{{ lang.myShowcaseEntryButtonDelete }}</span>
                        </a>
                        <script type="text/javascript">
                            // <!--
                            $('#quick_delete_{{ entry_data.entry_slug }}').css('display', '{{ entry_data.quick_delete_display }}');
                            // -->
                        </script>
                    {% endif %}

                    {# Delete button #}
                    {% if url_comment_restore %}
                        <form id="restoreEntryForm{{ entry_data.entry_slug }}" action="{{ restoreUrl }}" method="post"
                              style="display:none;">
                            <input type="hidden" name="my_post_key" value="{{ mybb.post_code }}"/>
                        </form>
                        <a href="javascript:void(0)" title="{{ lang.myShowcaseEntryButtonRestoreDescription }}"
                           class="postbit_qrestore"
                           onclick="Showcase.confirmSubmit('{{ lang.myShowcaseEntryButtonRestoreConfirm }}', 'restoreEntryForm{{ entry_data.entry_slug }}');"
                           style="display: inline;">
                            <span>{{ lang.myShowcaseEntryButtonRestore }}</span>
                        </a>
                    {% elseif url_comment_soft_delete %}
                        <form id="softDeleteEntryForm{{ entry_data.entry_slug }}" action="{{ softDeleteUrl }}"
                              method="post"
                              style="display:none;">
                            <input type="hidden" name="my_post_key" value="{{ mybb.post_code }}"/>
                        </form>
                        <a href="javascript:void(0)" title="{{ lang.myShowcaseEntryButtonSoftDeleteDescription }}"
                           class="postbit_qdelete"
                           onclick="Showcase.confirmSubmit('{{ lang.myShowcaseEntryButtonSoftDeleteConfirm }}', 'softDeleteEntryForm{{ entry_data.entry_slug }}');">
                            <span>{{ lang.myShowcaseEntryButtonSoftDelete }}</span>
                        </a>
                    {% endif %}

                    {# Report button #}
                    {% if show_report_button %}
                        <a href="javascript:void(0)"
                           onclick="Showcase.reportComment('{{ entry_data.entry_slug }}', {{ showcaseID }}); return false;"
                           title="{{ lang.myShowcaseEntryButtonReportDescription }}"
                           class="post-control post-control--report">
    {{ include('partials/icon.twig', {icon: 'flag', class: 'post-control__icon fa-fw'}, with_context = false) }}
                            <span class="post-control__text">{{ lang.myShowcaseEntryButtonReport }}</span>
                        </a>
                    {% endif %}

                    {# Warn user button #}
                    {% if show_warn_button %}
                        <a href="warnings.php?action=warn&amp;uid={{ userID }}&amp;showcase_id={{ showcaseID }}&amp;entry_slug={{ entry_data.entry_slug }}"
                           title="{{ lang.myShowcaseEntryButtonWarnDescription }}"
                           class="post-control post-control--warn">
                            {{ include('partials/icon.twig', {icon: 'exclamation-triangle', class: 'post-control__icon fa-fw'}, with_context =
                                false) }}
                            <span class="post-control__text">{{ lang.myShowcaseEntryButtonWarn }}</span>
                        </a>
                    {% endif %}

                    {# Purge spammer button #}
                    {% if show_purge_spammer_button %}
                        <a href="moderation.php?action=purgespammer&amp;uid={{ userID }}"
                           title="{{ lang.myShowcaseCommentButtonPurseSpammerDescription }}"
                           class="post-control post-control--purge-spammer">
    {{ include('partials/icon.twig', {icon: 'gavel', class: 'post-control__icon fa-fw'}, with_context = false) }}
    <span class="post-control__text">{{ lang.myShowcaseCommentButtonPurseSpammer }}</span>
</a>
                    {% endif %}
            </span>
            {% endif %}
        </div>
    </div>
</div>