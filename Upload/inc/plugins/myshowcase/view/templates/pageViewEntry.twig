<a name="{{ entry_data.entry_slug }}" id="{{ entry_data.entry_slug }}"></a>
{# Ignored post #}
{% if is_ignored %}
    <div class="post post--message ignored_post" id="ignored_post_{{ entry_data.entry_slug }}">
        <div class="post__meta">
            <h3 class="post__author">{{ post.profilelink|raw }}</h3>
        </div>
        <div class="post__body post__body--message post_body">
            {{ ignored_message }}
            <div class="post--message__button" id="show_ignored_link_{{ entry_data.entry_slug }}">
                <a href="javascript:void(0)"
                   onclick="Thread.showIgnoredPost({{ entry_data.entry_slug }}); return false;"
                   class="button">
                    {{ include('partials/icon.twig', {icon: 'eye', class: 'button__icon'}, with_context = false) }}
                    <span class="button__text">{{ lang.myshowcase_view_entry_button_ignored_deleted_show }}</span>
                </a>
            </div>
            <script type="text/javascript">
                <!--
                $('#show_ignored_link_{{ entry_data.entry_slug }}').show();
                // -->
            </script>
        </div>
    </div>
{% endif %}

{# Deleted post #}
{% if entry_data.status == 2 and permissions.can_manage_entries %}
    <div class="post post--message deleted_post_collapsed" id="deleted_post_{{ entry_data.entry_slug }}">
        <div class="post__meta">
            <h3 class="post__author">
                <a href="{{ get_profile_link(user_data.uid) }}">{{ user_data.uid|format_name }}</a>
            </h3>
        </div>
        <div class="post__body post__body--message post_body" id="deleted_post{{ entry_data.entry_slug }}">
            {{ trans(lang.myshowcase_view_entry_deleted_user, user_data.username) }}
            <div class="post--message__button" id="show_deleted_link_{{ entry_data.entry_slug }}">
                <a href="javascript:void(0)"
                   onclick="Thread.showDeletedPost({{ entry_data.entry_slug }}); return false;"
                   class="button">
                    {{ include('partials/icon.twig', {icon: 'eye', class: 'button__icon'}, with_context = false) }}
                    <span class="button__text">{{ lang.myshowcase_view_entry_button_ignored_deleted_show }}</span>
                </a>
            </div>
            <script type="text/javascript">
                <!--
                $('#show_deleted_link_{{ entry_data.entry_slug }}').show();
                // -->
            </script>
        </div>
    </div>
{% endif %}

{# Deleted post #}
{% if entry_data.extra_data.is_deleted %}
    <div class="post post--message deleted_entry_collapsed" id="deleted_entry_{{ entry_data.entry_slug }}">
        <div class="post__meta">
            <h3 class="post__author">
                <a href="{{ get_profile_link(user_data.uid) }}">{{ user_data.uid|format_name }}</a>
            </h3>
        </div>
        <div class="post__body post__body--message post_body" id="deleted_post{{ entry_data.entry_slug }}">
            {{ deletedMessage }}
            <div class="post--message__button" id="show_deleted_link_{{ entry_data.entry_slug }}">
                <a href="javascript:void(0)"
                   onclick="Showcase.showDeletedEntry('{{ entry_data.entry_slug }}'); return false;"
                   class="button">
                    {{ include('partials/icon.twig', {icon: 'eye', class: 'button__icon'}, with_context = false) }}
                    <span class="button__text">{{ lang.myshowcase_view_entry_button_ignored_deleted_show }}</span>
                </a>
            </div>
            <script type="text/javascript">
                <!--
                $('#show_deleted_link_{{ entry_data.entry_slug }}').show();
                // -->
            </script>
        </div>
    </div>
{% endif %}

{# Post bit #}
<div class="post {{ style_class }}" style="{{ style_visibility }}" id="entryBody{{ entry_data.entry_slug }}">
    <div class="post__meta">
        {# Author avatar #}
        {% if mybb.user.showavatars is defined and mybb.user.showavatars is not empty %}
            <a href="{{ get_profile_link(user_data.uid) }}" class="avatar-profile-link">
                {% if user_data.avatar %}
                    <img src="{{ user_avatar.image }}" alt="" {{ user_avatar.width_height|raw }} class="avatar"/>
                {% else %}
                    {% include 'partials/default_avatar.twig' %}
                {% endif %}
            </a>
        {% endif %}

        {# Author username #}
        <h3 class="post__author">
            <a href="{{ get_profile_link(user_data.uid) }}">{{ user_data.uid|format_name }}</a>
            {# Online status #}
            {% if userOnlineStatus == 'online' %}
                <span class="user-status user-status--online">
    <a href="{{ mybb.settings.bburl }}/online.php" title="{{ lang.myshowcase_view_entry_status_online }}"
       class="user-status__link">
        {{ include('partials/icon.twig', {icon: 'dot-circle', class: 'user-status__icon', title: lang.myshowcase_view_entry_status_online}, with_context = false) }}
    </a>
</span>
            {% elseif userOnlineStatus == 'away' %}
                <span class="user-status user-status--away">
    <a href="{{ get_profile_link(user_data.uid) }}" title="{{ lang.myshowcase_view_entry_status_away }}"
       class="user-status__link">
        {{ include('partials/icon.twig', {icon: 'dot-circle', class: 'user-status__icon', title: lang.myshowcase_view_entry_status_away}, with_context = false) }}
    </a>
</span>
            {% else %}
                <span class="user-status user-status--offline">
    {{ include('partials/icon.twig', {icon: 'dot-circle', class: 'user-status__icon', title: lang.myshowcase_view_entry_status_offline}, with_context = false) }}
</span>
            {% endif %}
        </h3>

        {# Entry date & permalink #}
        <a href="{{ url.entry }}#{{ entry_data.entry_slug }}" title="{{ subject }}" class="post__date">
            {{ entry_data.dateline|my_date }}
        </a>

        {# Inline moderation checkbox #}
        {% if permissions.can_manage_entries %}
            <label for="inlinemod_{{ entry_data.entry_slug }}"></label>
            <input type="checkbox" class="checkbox post__inline-mod" name="inlinemod_{{ entry_data.entry_slug }}"
                   id="inlinemod_{{ entry_data.entry_slug }}" value="1"
                   {% if entry_data.extra_data.moderator_check %}checked="checked"{% endif %}/>
        {% endif %}

        {% if entry_data.edit_user_id %}
            {# TO DO : CLEAN UP EDITED MESSAGE #}
            <a href="#" class="post__edit-log" title=""
               id="edited_by_{{ entry_data.entry_slug }}">{{ include('partials/icon.twig', {icon:
                    'pencil-alt', class: ''}, with_context = false) }}</a>
            <span class="edited_post"
                  style="display: none;">({{ myShowcaseEntryEditedBy|raw }} <a
                        href="{{ get_profile_link(entry_data.edit_user_id) }}">{{ entry_data.edit_user_id|format_name }}</a>.)</span>

        {% endif %}
    </div>

    {# Post body #}
    <div class="post__body post_body scaleimages" id="pid_{{ entry_data.entry_slug }}">
        {# Post unapproved or deleted message #}
        {% if entry_data.status == 0 or entry_data.status == 2 %}
            <div class="post__status">
                <span class="tag tag--post-status{% if entry_data.extra_data.is_deleted %} tag--deleted{% endif %}{% if entry_data.status == 0 %} tag--awaiting-approval{% endif %}">{{ entry_data.status }}</span>
            </div>
        {% endif %}

        {# Post message #}
        {% for field_id, field_data in fields_objects %}
            {% include '@ext.myshowcase/pageViewEntryField.twig' %}
        {% endfor %}

        {# Attachments #}
        {{ entry_attachments|raw }}

        {# Signature #}
        {% if user_signature %}
            <div class="post__signature scaleimages">
                {{ user_signature|raw }}
            </div>
        {% endif %}
    </div>

    {# Post controls #}
    <div class="post__foot post__foot--controls">
        <div class="post-controls post-controls--primary">
            {# Restore button (for deleted posts) #}
            {% if (permissions.can_delete_entries or permissions.can_manage_entries) %}
                <a href="editpost.php?pid={{ entry_data.entry_slug }}"
                   onclick="Thread.restorePost({{ entry_data.entry_slug }}); return false;"
                   style="display: none;" id="quick_restore_{{ entry_data.entry_slug }}"
                   title="{{ lang.myshowcase_view_entry_action_quick_restore_title }}"
                   class="post-control post-control--restore">
                    {{ include('partials/icon.twig', {icon: 'circle', class: 'post-control__icon fa-fw'}, with_context = false) }}
                    <span class="post-control__text">{{ lang.myshowcase_view_entry_action_quick_restore }}</span>
                </a>
                <script type="text/javascript">
                    // <!--
                    $('#quick_restore_{{ entry_data.entry_slug }}').css('display', '{% if entry_data.status != 2 %}none{% endif %}');
                    // -->
                </script>
            {% endif %}

            {# Reply to post button #}
            {% if entry_data.status == 1 and (permissions.can_create_comments or permissions.can_manage_comments) %}
                <a href="newreply.php?tid={{ entry_data.entry_slug }}&amp;replyto={{ entry_data.entry_slug }}"
                   title="{{ lang.myshowcase_view_entry_action_quote_title }}"
                   class="post-control post-control--reply"><i>{{ include('partials/icon.twig', {icon: 'comments', class: 'post-control__icon fa-fw'}, with_context = false) }}</i><span
                            class="post-control__text">{{ lang.myshowcase_view_entry_action_quote }}</span></a>
            {% endif %}

            {# Multiquote button #}
            {% if entry_data.status == 1 and (permissions.can_create_comments or permissions.can_manage_comments) %}
                <a href="javascript:void(0)" onclick="Thread.multiQuote({{ entry_data.entry_slug }}); return false;"
                   style="display: none;" id="multiquote_link_{{ entry_data.entry_slug }}"
                   title="{{ lang.myshowcase_view_entry_action_multi_quote_title }}"
                   class="postbit_multiquote post-control post-control--quote">
                    {{ include('partials/icon.twig', {icon: 'quote-left', class: 'post-control__icon fa-fw'}, with_context = false) }}
                    <span id="multiquote_{{ entry_data.entry_slug }}"
                          class="post-control__text">{{ lang.myshowcase_view_entry_action_multi_quote }}</span>
                </a>
                <script type="text/javascript">
                    //<!--
                    $('#multiquote_link_{{ entry_data.entry_slug }}').css("display", "");
                    // -->
                </script>
            {% endif %}

            {# Reputation button #}
            {% if mybb.settings.enablereputation and mybb.settings.postrep and mybb.usergroup.cangivereputations and user_permissions.usereputationsystem and (mybb.settings.posrep or mybb.settings.neurep or mybb.settings.negrep) and user_data.uid != mybb.user.uid and entry_data.status == 1 %}
                <a href="javascript:void(0)"
                   onclick="MyBB.reputation({{ user_data.uid }}, {{ entry_data.entry_slug }}); return false;"
                   title="{{ lang.myshowcase_view_entry_action_rate_title }}" class="post-control post-control--rate">
                    {{ include('partials/icon.twig', {icon: 'thumbs-up', class: 'post-control__icon fa-fw'}, with_context = false) }}
                    <span class="post-control__text">{{ lang.myshowcase_view_entry_action_rate }}</span>
                </a>
            {% endif %}
        </div>
        <div class="post-controls post-controls--secondary post-options">
            {% if
                (entry_data.entry_id and (
                (permissions.can_update_entries or permissions.can_manage_entries) or
                (permissions.can_delete_entries or permissions.can_manage_entries)
                )) or
                (mybb.user.uid not in entry_data.extra_data.reporters_list and user_permissions.canbereported) or
                (mybb.usergroup.canwarnusers and user_data.uid != mybb.user.uid) or
                (show_purge_spammer_button) %}
                <input type="checkbox" class="post-options__checkbox" id="post_options_{{ entry_data.entry_slug }}">
                <label for="post_options_{{ entry_data.entry_slug }}"
                       class="post-control post-control--options post-options__control"
                       title="{{ lang.myshowcase_view_entry_options }}">
                    {{ include('partials/icon.twig', {icon: 'ellipsis-v', class: 'post-control__icon fa-fw'}, with_context = false) }}
                    <span class="visually-hidden">{{ lang.myshowcase_view_entry_options }}</span>
                </label>
                <span class="post-options__list" id="post_options2_{{ entry_data.entry_slug }}">
                    {# Edit button #}
                    {% if entry_data.entry_id and (permissions.can_update_entries or permissions.can_manage_entries) %}
                        <a href="{{ config.url_showcase }}/{{ url.update }}"
                           class="post-control post-control--full-edit">
                            {{ include('partials/icon.twig', {icon: 'edit', class: 'post-control__icon fa-fw'}, with_context = false) }}
                            <span class="post-control__text">{{ lang.myshowcase_view_entry_options_full_edit }}</span>
                        </a>
                    {% endif %}

                    {# Delete button #}
                    {% if entry_data.entry_id and (permissions.can_delete_entries or permissions.can_manage_entries) %}
                        <a href="editpost.php?pid={{ entry_data.entry_slug }}"
                           onclick="Thread.deletePost({{ entry_data.entry_slug }}); return false;"
                           style="display: none;"
                           id="quick_delete_{{ entry_data.entry_slug }}"
                           title="{{ lang.myshowcase_view_entry_options_quick_delete_title }}"
                           class="post-control post-control--delete">
                            {{ include('partials/icon.twig', {icon: 'trash', class: 'post-control__icon fa-fw'}, with_context = false) }}
                            <span class="post-control__text">{{ lang.myshowcase_view_entry_options_quick_delete }}</span>
                        </a>
                        <script type="text/javascript">
    // <!--
    $('#quick_delete_{{ entry_data.entry_slug }}').css('display', '{% if entry_data.status ==2 %}none{% endif %}');
    // -->
    </script>
                    {% endif %}

                    {# Report button #}
                    {% if mybb.user.uid not in entry_data.extra_data.reporters_list and user_permissions.canbereported %}
                        <a href="javascript:void(0)"
                           onclick="Report.reportPost({{ entry_data.entry_slug }}); return false;"
                           title="{{ lang.myshowcase_view_entry_options_report_title }}"
                           class="post-control post-control--report">
                            {{ include('partials/icon.twig', {icon: 'flag', class: 'post-control__icon fa-fw'}, with_context = false) }}
                            <span class="post-control__text">{{ lang.myshowcase_view_entry_options_report }}</span>
                        </a>
                    {% endif %}

                    {# Warn user button #}
                    {% if mybb.usergroup.canwarnusers and user_data.uid != mybb.user.uid %}
                        <a href="{{ mybb.settings.bburl }}/warnings.php?action=warn&amp;uid={{ user_data.uid }}&amp;pid={{ entry_data.entry_slug }}"
                           title="{{ lang.myshowcase_view_entry_options_warn_title }}"
                           class="post-control post-control--warn">
                            {{ include('partials/icon.twig', {icon: 'exclamation-triangle', class: 'post-control__icon fa-fw'}, with_context = false) }}
                            <span class="post-control__text">{{ lang.myshowcase_view_entry_options_warn }}</span>
                        </a>
                    {% endif %}

                    {# Purge spammer button #}
                    {% if show_purge_spammer_button %}
                        <a href="{{ mybb.settings.bburl }}/moderation.php?action=purgespammer&amp;uid={{ user_data.uid }}"
                           title="{{ lang.myshowcase_view_entry_options_purge_spammer_title }}"
                           class="post-control post-control--purge-spammer">
                            {{ include('partials/icon.twig', {icon: 'gavel', class: 'post-control__icon fa-fw'}, with_context = false) }}
                            <span class="post-control__text">{{ lang.myshowcase_view_entry_options_purge_spammer }}</span>
                        </a>
                    {% endif %}
                </span>
            {% endif %}
        </div>
    </div>
</div>