<div class="row row--thread thread thread--default inline_row
    {% if entry.extra_data.unread_comments %} thread--unread{% endif %}
    {% if entry.is_sticky %} thread--sticky{% endif %}
    {% if entry_moderator %} thread--moderator{% endif %}
    {% if entry.status == 2 %} thread--deleted{% endif %}
    {% if entry.status == 0 %} thread--awaiting-approval{% endif %}">

    {# The first image of the entry's file fields #}
    {% if entry.extra_data.main_image %}
        <a href="{{ config.showcase_url }}{{ entry.extra_data.url }}" class="thread__image">
            <img src="{{ config.showcase_url }}{{ entry.extra_data.main_image.url }}" alt="{{ entry.extra_data.main_image.name }}"
                 style="max-width: 80px; max-height: 80px;"/>
        </a>
    {% endif %}

    <div class="thread__title">
        <h3 class="thread__subject">
            <a href="{{ config.showcase_url }}{{ entry.extra_data.url }}">{{ entry.extra_data.subject_html|raw }}</a>
        </h3>

        {# Only their author and moderators see waiting entries, only moderators deleted ones #}
        {% if entry.status == 2 %}
            <span class="thread__status tag tag--thread-status tag--deleted">{{ lang.myshowcase_main_table_row_deleted_entry }}</span>
        {% endif %}

        {% if entry.status == 0 %}
            <span class="thread__status tag tag--thread-status tag--awaiting-approval">{{ lang.myshowcase_main_table_row_awaiting_approval }}</span>
        {% endif %}
    </div>

    <div class="thread__icons">
        {% if entry.is_closed %}
            {{ include('partials/icon.twig', {icon: 'lock', class: 'thread__icon thread__icon--closed fa-fw', title: lang.myshowcase_main_table_row_closed_entry}, with_context = false) }}
        {% endif %}

        {% if entry.is_sticky %}
            {{ include('partials/icon.twig', {icon: 'thumbtack', class: 'thread__icon thread__icon--sticky fa-fw', title: lang.sticky}, with_context = false) }}
        {% endif %}
    </div>

    <div class="thread__author">
        {{ lang.myshowcase_main_table_row_by }}
        <span class="thread__overflow">
            {% if entry.user_id > 0 %}
                <a href="{{ get_profile_link(entry.user_id) }}">{{ entry.user_id|format_name }}</a>
            {% else %}
                {{ entry.username ?: lang.guest }}
            {% endif %}
        </span>
        <span class="thread__date">{{ entry.extra_data.dateline_timestamp|my_date }}</span>
    </div>

    <div class="thread__replies thread__count thread__count--replies">
        <span class="thread__reply-count">{{ entry.comments_approved|my_number_format }}</span>
        <span class="thread__legend">{% if entry.comments_approved == 1 %}{{ lang.myshowcase_main_table_row_comment }}{% else %}{{ lang.myshowcase_main_table_row_comments }}{% endif %}</span>
    </div>

    <div class="thread__views thread__count thread__count--views">
        {{ entry.views|my_number_format }}
        <span class="thread__legend">{% if entry.views == 1 %}{{ lang.myshowcase_main_table_row_view }}{% else %}{{ lang.myshowcase_main_table_row_views }}{% endif %}</span>
    </div>

    {# Custom fields shown in the list, in render order; the values are escaped or parsed by the field classes. #}
    {# The image of the row stands for the file fields. #}
    {% set main_fields = entry.getFields()|filter(field_data => field_data.isViewableInMain() and not (entry.extra_data.main_image and field_data.field_definition.html_type == 'file') and (field_data.getUserValue() is not same as('') or field_data.attachments_rendered is not empty))|sort((a, b) => a.field_definition.render_order <=> b.field_definition.render_order) %}
    {% if main_fields is not empty %}
        <div class="thread__fields">
            {% for field_data in main_fields %}
                <span class="thread__field thread__field--{{ field_data.field_definition.field_key }}">
                    <span class="thread__field-label">{{ field_data.getLabel() }}:</span>
                    <span class="thread__field-value">{% if field_data.hasOptions() %}{{ field_data.getUserValueDisplay()|raw }}{% else %}{{ field_data.getUserValue()|raw }}{{ field_data.attachments_rendered|raw }}{% endif %}</span>
                </span>
            {% endfor %}
        </div>
    {% endif %}

    <div class="thread__latest latest-post">
        <span class="latest-post__text">{{ lang.lastpost_by }}</span>
        <span class="latest-post__author">
            {% if entry.extra_data.last_commenter_user_data %}
                <a href="{{ get_profile_link(entry.extra_data.last_commenter_user_data.uid) }}">{{ entry.extra_data.last_commenter_user_data.uid|format_name }}</a>
            {% else %}
                {{ entry.last_comment_username ?? lang.guest }}
            {% endif %}
        </span>
        <a href="{{ entry.extra_data.url_last_comment }}"
           class="latest-post__date">{{ entry.extra_data.last_comment_date.getTimestamp() }}</a>
    </div>

    {% if entry_moderator %}
        <div class="thread__checkbox">
            <label for="selected-entry-{{ entry.entry_slug }}"></label>
            <input type="checkbox" class="checkbox checkbox--select-row" data-slug="{{ entry.entry_slug }}"
                   id="selected-entry-{{ entry.entry_slug }}"
                   {% if entry.extra_data.selected %}checked="checked"{% endif %} />
        </div>
    {% endif %}
</div>
{# TODO, Entry attachments
        {% if config.attachments_allow_in_entries and config.attachments_main_render and permissions.attachments_can_view and entry.getAttachments() is not empty %}
            {% for attachment_id,attachment_data in entry.getAttachments() %}
                {% include '@ext.myshowcase/pageMainEntryAttachment.twig' %}
            {% endfor %}
        {% endif %}
#}