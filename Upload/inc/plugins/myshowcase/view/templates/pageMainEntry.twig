<div class="row row--thread thread inline_row
    {% if entry.unreadpost %} thread--unread{% endif %}
    {% if can_manage_entries %} thread--moderator{% endif %}
    {% if entry.visible == -1 and can_manage_entries %} thread--deleted{% endif %}
    {% if entry.visible == 0 %} thread--awaiting-approval{% endif %}">
    <div class="thread__column thread__column--primary">
        <h3 class="thread__title">
            {# Thread title #}
            <span class="{{ entry.inlineEditClass }} {{ entry.newclass }}" id="tid_{{ entry.entry_id }}">
                <a href="{{ entry.entryUrl }}">{{ entry.entrySubject|raw }}</a>
            </span>

            {# Deleted thread #}
            {% if entry.visible == -1 %}
                <span class="tag tag--thread-status tag--deleted">{{ lang.deleted_thread }}</span>
            {% endif %}

            {% if entry.visible == 0 %}
                <span class="tag tag--thread-status tag--awaiting-approval">{{ lang.awaiting_approval }}</span>
            {% endif %}

            {# Go to unread link #}
            {% if entry.unreadpost %}
                <a href="{{ entry.newpostlink }}" class="thread__status">
                    {{ include('partials/icon.twig', {icon: 'circle', class: '', title: lang.goto_first_unread}, with_context = false) }}
                </a>
            {% endif %}

            {# Thread status icons #}
            <span class="thread__icons">
                {# Thread icon #}

                {# Contains posts by you #}
                {% if 'dot' in entry.folder.value %}
                    {{ include('partials/icon.twig', {icon: 'user-circle', class: 'thread__icon fa-fw', title: lang.posts_by_you}, with_context = false) }}
                {% endif %}

                {# Attachment paperclip #}
                {% if mybb.settings.enableattachments and entry.attachmentcount %}
                    {% set attachment_title = (entry.attachmentcount > 1) ? trans('attachment_count_multiple', entry.attachmentcount) : lang.attachment_count %}
                    {{ include('partials/icon.twig', {icon: 'paperclip', class: 'thread__icon fa-fw', title: attachment_title}, with_context = false) }}
                {% endif %}

                {# Hot thread #}
                {% if 'hot' in entry.folder.value %}
                    {{ include('partials/icon.twig', {icon: 'fire', class: 'thread__icon fa-fw', title: lang.hot}, with_context = false) }}
                {% endif %}

                {# Closed #}
                {% if entry.closed %}
                    {{ include('partials/icon.twig', {icon: 'lock', class: 'thread__icon fa-fw', title: lang.closed}, with_context = false) }}
                {% endif %}
            </span>
        </h3>
        <p class="thread__author">{{ lang.by }} <a
                    href="{{ get_profile_link(entry.user_id) }}">{{ entry.user_id|format_name }}</a> {{ entry.dateline|my_date }}
        </p>
    </div>
    {% for render_order, field_id in fieldSetFieldsOrder %}
        <div class="thread__column thread__column--replies">
            <p class="thread__replies">
                {{ entry.fieldCache[field_id]|raw }}
            </p>
        </div>
    {% endfor %}
    <div class="thread__column thread__column--replies">
        <p class="thread__replies">
            <span title="{{ lang.replies }}: {{ entry.comments }} &middot; {{ lang.views }}: {{ entry.views }}"
                  class="thread__reply-count">{{ entry.comments }}</span>
            <span class="thread__reply-legend">{% if entry.comments == 1 %}{{ lang.reply }}{% else %}{{ lang.replies }}{% endif %}</span>
        </p>
    </div>
    <div class="thread__column thread__column--latest">
        <p class="thread__latest-post">
            {% if entry.last_commenter_user_data %}
                <span class="thread__latest-post__text">{{ lang.lastpost_by }}</span>
                <a href="{{ entry.entryUrlLastComment }}" class="avatar-profile-link">
                    {{ render_avatar(url=entry.last_commenter_user_data.avatar, alt=entry.last_commenter_user_data.username, class='avatar--smallest') }}
                </a>
                <span class="thread__latest-post__author">
                    {% if entry.last_commenter_user_data.uid > 0 %}
                        <a href="{{ get_profile_link(entry.last_commenter_user_data.uid) }}">{{ entry.last_commenter_user_data.uid|format_name }}</a>
                    {% else %}
                        {{ lang.guest }}
                    {% endif %}
                </span>
                <a href="{{ entry.lastpostlink }}"
                   class="thread__latest-post__date">{{ entry.lastpostdate|my_date }}</a>
            {% else %}
                {{ lang.na }}
            {% endif %}
        </p>
    </div>
    {% if can_manage_entries %}
        <div class="thread__column thread__column--checkbox">
            <label for="inlinemod_{{ entry.entry_id }}"></label>
            <input type="checkbox" class="checkbox" name="inlinemod_{{ entry.entry_id }}"
                   id="inlinemod_{{ entry.entry_id }}"
                   value="1"{% if entry.moderator_check %} checked{% endif %} />
        </div>
    {% endif %}
</div>
