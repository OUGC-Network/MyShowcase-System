<section class="section section--form section--has-title compose__hidden-section compose__hidden-section--options">
    <h2 class="title title--section">{{ lang.thread_subscription_method }}</h2>
    <div class="section__container">
        <div class="row row--form field">
            <p class="option-field option-field--compact">
                <label>
                    <input type="radio" name="subscription_method"
                           value="" {{ not mybb.input.subscription_method is defined ? 'checked="checked"' }}/> {{ lang.no_subscribe }}
                </label>
            </p>
            <p class="option-field option-field--compact">
                <label>
                    <input type="radio" name="subscription_method" value="1"
                            {{ mybb.input.subscription_method is defined and mybb.input.subscription_method == 1 ? 'checked="checked"' }} />
                    {{ lang.no_subscribe_notification }}
                </label>
            </p>
            <p class="option-field option-field--compact">
                <label>
                    <input type="radio" name="subscription_method" value="2"
                            {{ mybb.input.subscription_method is defined and mybb.input.subscription_method == 2 ? 'checked="checked"' }} />
                    {{ lang.instant_email_subscribe }}
                </label>
            </p>
            <p class="option-field option-field--compact">
                <label>
                    <input type="radio" name="subscription_method" value="3"
                            {{ mybb.input.subscription_method is defined and mybb.input.subscription_method == 3 ? 'checked="checked"' }} />
                    {{ lang.instant_pm_subscribe }}
                </label>
            </p>
        </div>
    </div>
</section>
