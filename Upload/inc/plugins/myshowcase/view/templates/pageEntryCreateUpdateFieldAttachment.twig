<div class="row row--form field uploaded-attachment" id="attachment_{{ attachment_id }}">
    <div class="uploaded-attachment__details">
        {% if attachment_data.extra_data.is_image %}
            <a href="{{ config.showcase_url }}{{ attachment_data.extra_data.url }}" target="_blank" class="uploaded-attachment__preview">
                <img src="{{ config.showcase_url }}{{ attachment_data.extra_data.url_thumbnail }}" alt="" style="max-width: 80px; max-height: 80px;"/>
            </a>
        {% else %}
            <span class="uploaded-attachment__icon">{{ attachment_data.extra_data.icon|raw }}</span>
        {% endif %}
        <span class="uploaded-attachment__file-name">
            <a href="{{ config.showcase_url }}{{ attachment_data.extra_data.url }}" target="_blank">{{ attachment_data.attachment_name }}</a>
        </span>
        <span class="uploaded-attachment__file-size">({{ attachment_data.extra_data.file_size }})</span>
    </div>
    <div class="uploaded-attachment__buttons">
        {# Removed when the form is saved; a file uploaded in the field above replaces it. #}
        <label class="button button--secondary">
            <input type="checkbox" class="checkbox" name="remove_attachments[]" value="{{ attachment_id }}" form="contentForm"/>
            {{ include('partials/icon.twig', {icon: 'trash', class: 'button__icon'}, with_context = false) }}
            <span class="button__text">{{ lang.remove_attachment }}</span>
        </label>
    </div>
</div>
