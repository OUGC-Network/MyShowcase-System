{% extends 'layouts/master.twig' %}

{% block head %}
    <title>{{ showcase.name }} - {{ mybb.settings.bbname }}</title>
    <meta property="og:site_name" content="{{ mybb.settings.bbname }}">

    {% if meta.canonical %}
        <link rel="canonical" href="{{ meta.canonical }}"/>
    {% endif %}

    {% if meta.page %}
        {% for page_data in meta.page %}
            <meta property="{{ page_data.property }}" content="{{ page_data.content }}">
        {% endfor %}
    {% endif %}
{% endblock head %}

{% block jscripts %}
    <script type="text/javascript"
            src="{{ mybb.settings.bburl }}/jscripts/myshowcase.js?ver={{ showcase.version }}"></script>
{% endblock jscripts %}

{% block body %}
    <div class="page-content">
    <header class="page-header">
        <h1 class="title title--page">
            {{ showcase.name }}
        </h1>
        {% if showcase.description %}
            <p class="page-description">{{ showcase.description }}</p>
        {% endif %}
    </header>

    {# Moderated by #}
    {% if moderators %}
        <p>{{ lang.myshowcase_main_moderated_by }}:
            <strong>
                {% for moderator in moderators.users %}
                    <a
                    href="{{ get_profile_link(moderator.user_id) }}">{{ moderator.user_id|format_name }}</a>{% if loop.last == false %}{{ lang.comma }} {% endif %}
                {% endfor %}
                {% if moderators.users and moderators.groups %}{{ lang.comma }} {% endif %}
                {% for moderator in moderators.groups %}
                    {% set group_data = {
                        username: moderator.title,
                        usergroup: moderator.group_id
                    } %}
                    {{ group_data|format_name }}{% if loop.last == false %}{{ lang.comma }} {% endif %}
                {% endfor %}
            </strong>
        </p>
    {% endif %}

    {% if url_entry_create %}
        {% set button_new_entry %}
            <a href="{{ url_entry_create }}" class="button button--medium button--full-width">
                {{ include('partials/icon.twig', {icon: 'pencil-alt', class: 'button__icon'}, with_context = false) }}
                <span class="button__text">{{ lang.myshowcase_main_button_entry_create }}</span>
            </a>
        {% endset %}
    {% endif %}

    <div class="page-controls page-controls--top">
        <div class="page-buttons">
            {{ button_new_entry }}
        </div>
        {{ pagination|raw }}
    </div>
    <section class="thread-list">
        {# Sorting #}
        {% set ascDesc %}
            <span class="sort-threads__order">
                        {% if sorting.direction == 'desc' %}
                            {{ include('partials/icon.twig', {icon: 'chevron-circle-up', class: '', title: sorting.direction}, with_context = false) }}
                        {% else %}
                            {{ include('partials/icon.twig', {icon: 'chevron-circle-down', class: '', title: sorting.direction}, with_context = false) }}
                        {% endif %}
                    </span>
        {% endset %}
        <div class="sort-threads">
            <div class="sort-threads__column sort-threads__column--primary">
                        <span class="sort-threads__subject"><a
                                    href="{{ url.sort.subject }}"
                                    class="sort-threads__link sort-threads__link--subject">{{ lang.myshowcase_main_table_head_entry }}{% if sorting.field == 'subject' %}{{ ascDesc }}{% endif %}</a></span>
                <span class="sort-threads__author">&mdash; <a
                            href="{{ url.sort.username }}"
                            class="sort-threads__link sort-threads__link--author">{{ lang.myshowcase_main_table_head_author }}{% if sorting.field == 'username' %}{{ ascDesc }}{% endif %}</a></span>
            </div>
            {% for render_order, field_id in fieldSetFieldsOrder %}
                {% if fieldSetCache[field_id].display_in_main_page %}
                    <div class="sort-threads__column sort-threads__column--replies">
                        <a href="{{ url.sort[fieldSetCache[field_id].field_key] }}"
                           class="sort-threads__link">{{ attribute(lang, 'myshowcase_fieldset_field_' ~ fieldSetCache[field_id].field_key) }}</a> {% if sorting.field == fieldSetCache[field_id].field_key %}{{ ascDesc }}{% endif %}
                    </div>
                {% endif %}
            {% endfor %}
            <div class="sort-threads__column sort-threads__column--replies">
                <a href="{{ url.sort.comments }}"
                   class="sort-threads__link sort-threads__link--replies">{{ lang.myshowcase_main_table_head_comments }}{% if sorting.field == 'comments' %}{{ ascDesc }}{% endif %}</a>
            </div>
            <div class="sort-threads__column sort-threads__column--latest">
                <a href="{{ url.sort.last_comment }}"
                   class="sort-threads__link sort-threads__link--latest">{{ lang.myshowcase_main_table_head_last_comment }}{% if sorting.field == 'dateline' %}{{ ascDesc }}{% endif %}</a>
            </div>
            {% if permissions.can_manage_entries %}
                <span class="sort-threads__column sort-threads__column--checkbox">
                            <label>
                                <input type="checkbox" name="allbox" onclick="inlineModeration.checkAll(this)"/>
                            </label>
                        </span>
            {% endif %}
        </div>

        {# Select all #}
        {% if true or permissions.can_manage_entries and entries_count > showcase.entries_per_page %}
            <div class="thread-list__select-all" id="selectAllrow">
                {{ trans('myshowcase_main_table_separator_selected_page', entries_count) }} <a href="javascript:void(0)"
                                                                                               onclick='inlineModeration.selectAll(); return false;'>{{ trans('select_all', entries_count) }}</a>
            </div>
            <div class="thread-list__select-all" id="allSelectedrow">
                {{ trans('myshowcase_main_table_separator_selected_all', entries_count) }} <a href="javascript:void(0)"
                                                                                              onclick='inlineModeration.clearChecked(); return false;'>{{ lang.myshowcase_main_table_separator_selected_pall_clear }}</a>
            </div>
        {% endif %}

        {# Threads – errors #}
        {% if not entries_count %}
            <div class="alert alert--no-results">
                {% if keywords %}
                    {{ lang.myshowcase_main_table_empty_search }}
                {% else %}
                    {{ lang.myshowcase_main_table_empty }}
                {% endif %}
            </div>
        {% else %}
            <div class="thread-list__container">
                {% if entry_sticky_objects is not empty %}
                    <div class="thread-list__normal-threads">
                        <h2 class="visually-hidden">{{ lang.myshowcase_main_table_separator_sticky }}</h2>
                    </div>
                    {% for entry_data in entry_sticky_objects %}

                        {% if permissions.can_manage_entries and entry_data.status == 2 and permissions.can_manage_entries %}
                            {% include '@ext.myshowcase/pageMainEntryDeleted.twig' %}
                        {% else %}
                            {% include '@ext.myshowcase/pageMainEntry.twig' %}
                        {% endif %}

                    {% endfor %}
                {% endif %}

                {% if entry_normal_objects is not empty %}
                    <div class="thread-list__normal-threads">
                        <h2 class="visually-hidden">{{ lang.myshowcase_main_table_separator_normal }}</h2>
                    </div>
                    {% for entry_data in entry_normal_objects %}

                        {% if permissions.can_manage_entries and entry_data.status == 2 and permissions.can_manage_entries %}
                            {% include '@ext.myshowcase/pageMainEntryDeleted.twig' %}
                        {% else %}
                            {% include '@ext.myshowcase/pageMainEntry.twig' %}
                        {% endif %}

                    {% endfor %}
                {% endif %}
            </div>
        {% endif %}

        {# Threadlist footer #}
        <div class="sort-results">
            <form action="{{ url.main }}" method="get">
                <input type="hidden" name="page" value="{{ current_page }}"/>
                <h3 class="sort-results__title visually-hidden">{{ lang.myshowcase_main_sort_entries }}</h3>
                <div class="select-field">
                    {{ include('partials/icon.twig', {icon: 'sort', class: 'select-field__icon'}, with_context = false) }}
                    <label>
                        <select name="sort">
                            {% for field_key, field_display_name in showcase.fieldset_display_fields %}
                                <option value="{{ field_key }}"{% if field_key == sorting.field %} selected{% endif %}>{{ lang.myshowcase_main_sort_field }}
                                    : {% if attribute(lang, 'myshowcase_main_sort_field_' ~ field_key) is defined %}{{ attribute(lang, 'myshowcase_main_sort_field_' ~ field_key) }}{% else %}{{ field_key }}{% endif %}</option>
                            {% endfor %}
                        </select>
                    </label>
                </div>
                <div class="select-field">
                    {{ include('partials/icon.twig', {icon: 'sort', class: 'select-field__icon'}, with_context = false) }}
                    <label>
                        <select name="direction">
                            {% for field in ['asc', 'desc'] %}
                                <option value="{{ field }}"{% if mybb.input.direction is defined and field == mybb.input.direction %} selected="selected"{% endif %}>
                                    {{ lang.myshowcase_main_sort_direction }}
                                    : {{ attribute(lang, 'myshowcase_main_sort_direction_' ~ field) }}</option>
                            {% endfor %}
                        </select>
                    </label>
                </div>
                <div class="select-field">
                    {{ include('partials/icon.twig', {icon: 'sort', class: 'select-field__icon'}, with_context = false) }}
                    <label>
                        <select name="days">
                            <option value="1"{% if mybb.input.days is defined and mybb.input.days == 1 %} selected{% endif %}>{{ lang.myshowcase_main_sort_days_1 }}</option>
                            {% for field in [5, 25, 100] %}
                                <option value="{{ field }}"{% if mybb.input.days is defined and mybb.input.days == field %} selected{% endif %}>{{ attribute(lang, 'myshowcase_main_sort_days_' ~ field ) }}</option>
                            {% endfor %}
                        </select>
                    </label>
                </div>
                <button type="submit" class="button button--inline">
                    {{ include('partials/icon.twig', {icon: 'random', class: 'button__icon'}, with_context = false) }}
                    <span class="button__text">{{ lang.myshowcase_main_button_sort_entries }}</span>
                </button>
            </form>
        </div>
    </section>

    {{ pagination|raw }}

    <footer class="page-footer">
        <div class="row row--no-border page-tools">
            {# Search #}
            <div class="forum-search page-tools__item">
                <h2 class="title title--legend {% if not permissions.can_manage_entries %}visually-hidden{% endif %}">{{ lang.myshowcase_main_search }}</h2>
                <form action="{{ url.main }}" method="get">
                    <label>
                        <input type="text" name="keywords"
                               placeholder="{{ lang.myshowcase_main_search_keywords }}"
                               class="textbox textbox--large" value="{{ keywords }}"/>
                    </label>
                    <input type="hidden" name="page" value="{{ current_page }}"/>
                    <button type="submit" class="button button--inline">
                        {{ include('partials/icon.twig', {icon: 'search', class: 'button__icon'}, with_context = false) }}
                        <span class="button__text">{{ lang.myshowcase_main_button_search }}</span>
                    </button>
                </form>
            </div>

            {# Inline moderation #}
            {% if permissions.can_manage_entries %}
                {% include '@ext.myshowcase/pageMainInlineModeration.twig' %}
            {% endif %}
        </div>

        {# Users browsing #}
        {% if mybb.settings.browsingthisforum %}
            <div class="container container--small container--users-browsing">{{ lang.myshowcase_main_users_browsing }}
                {% for user in users_browsing %}
                    <a
                    href="{{ get_profile_link(user.uid) }}">{{ user.uid|format_name }}</a>{% if user.invisible %}*{% endif %}{% if loop.last == false %}{{ lang.comma }} {% endif %}
                {% endfor %}

                {% if users_browsing_counter.invisible and mybb.usergroup.canviewwolinvis != 1 %}
                    {% if users_browsing %}{{ lang.comma }} {% endif %}{{ trans('users_browsing_forum_guests', users_browsing_counter.guests) }}
                {% endif %}

                {% if users_browsing_counter.guests %}
                    {% if users_browsing or (users_browsing_counter.invisible and mybb.usergroup.canviewwolinvis != 1) %}{{ lang.comma }} {% endif %}{{ trans('myshowcase_main_users_browsing_guests', users_browsing_counter.guests) }}
                {% endif %}
            </div>
        {% endif %}
    </footer>
{% endblock body %}