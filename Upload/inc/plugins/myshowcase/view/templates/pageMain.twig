{% extends 'layouts/master.twig' %}

{% block head %}
    <title>{{ config.name }} - {{ mybb.settings.bbname }}</title>
    <meta property="og:site_name" content="{{ mybb.settings.bbname }}">

    {% if meta.canonical is defined and meta.canonical %}
        <link rel="canonical" href="{{ meta.canonical }}"/>
    {% endif %}

    {% if meta.page %}
        {% for meta_data in meta.page %}
            <meta property="{{ meta_data.property }}" content="{{ meta_data.content }}">
        {% endfor %}
    {% endif %}
{% endblock head %}

{% block jscripts %}
    <script type="text/javascript"
            src="{{ mybb.settings.bburl }}/jscripts/myshowcase.js?ver={{ config.version }}"></script>
{% endblock jscripts %}

{% block body %}
    <div class="page-content">
    <header class="page-header">
        <h1 class="title title--page"> {{ config.name }}</h1>
        {% if config.description %}
            <p class="page-description">{{ config.description }}</p>
        {% endif %}
    </header>

    {# Moderated by #}
    {% if config.main_display_moderators and moderators is not empty %}
        <p>{{ lang.myshowcase_main_moderated_by }}:
            <strong>
                {% for moderator in moderators.users %}
                    {% set user_data = {
                        username: moderator.username,
                        usergroup: moderator.group_id,
                        displaygroup: moderator.display_group_id
                    } %}
                    <a
                    href="{{ get_profile_link(moderator.user_id) }}">{{ moderator.user_id|format_name }}</a>{% if loop.last == false %}{{ lang.comma }} {% endif %}
                {% endfor %}
                {% if moderators.users and moderators.groups %}{{ lang.comma }} {% endif %}
                {% for moderator in moderators.groups %}
                    {% set group_data = {
                        username: moderator.title,
                        usergroup: moderator.group_id
                    } %}
                    {{ group_data|format_name }}{% if loop.last == false %}{{ lang.comma }} {% endif %}
                {% endfor %}
            </strong>
        </p>
    {% endif %}

    {# Forum rules #}
    {% if config.rules_type > 0 and config.rules_content %}
        <section class="container container--forum-rules">
            {% if config.rules_type == 3 %}
                <strong>
                    <a href="{{ config.rules_content }}">{{ config.rules_title|default(trans('forum_rules', config.name)) }}</a>
                </strong>
            {% else %}
                <h4 class="title title--container">{{ config.rules_title|default(trans('forum_rules', config.name)) }}</h4>
                {{ config.rules_content }}
            {% endif %}
        </section>
    {% endif %}

    {% if url_entry_create %}
        {% set button_new_entry %}
            <a href="{{ url.showcase }}{{ url_entry_create }}" class="button button--medium button--full-width">
                {{ include('partials/icon.twig', {icon: 'pencil-alt', class: 'button__icon'}, with_context = false) }}
                <span class="button__text">{{ lang.myshowcase_main_button_entry_create }}</span>
            </a>
        {% endset %}
    {% endif %}

    <div class="page-controls page-controls--top">
        <div class="page-buttons">
            <a href="{{ url.showcase }}{{ url.main }}?action=markread&amp;{% if current_user.user_id %}&amp;my_post_key={{ mybb.post_code }}{% endif %}"
               class="button button--medium button--secondary button--half-width">
                {{ include('partials/icon.twig', {icon: 'dot-circle', class: 'button__icon'}, with_context = false) }}
                <span class="button__text">{{ lang.myshowcase_main_button_read }}</span>
            </a>
            <a href="{{ url.showcase }}{{ url.main }}?action=subscribe&amp;type=forum&amp;&amp;my_post_key={{ mybb.post_code }}"
               class="button button--medium button--secondary button--half-width">
                {% if 'add' == 'add' %}
                    {{ include('partials/icon.twig', {icon: 'plus', class: 'button__icon'}, with_context = false) }}
                    <span class="button__text">{{ lang.myshowcase_main_button_subscribe }}</span>
                {% else %}
                    {{ include('partials/icon.twig', {icon: 'minus', class: 'button__icon'}, with_context = false) }}
                    <span class="button__text">{{ lang.myshowcase_main_button_unsubscribe }}</span>
                {% endif %}
            </a>
            {% if config.password %}
                <a href="{{ url.showcase }}{{ url.clear_password }}"
                   class="button button--medium button--secondary button--full-width">
                    {{ include('partials/icon.twig', {icon: 'key', class: 'button__icon'}, with_context = false) }}
                    {{ lang.myshowcase_main_button_clear_stored_password }}</a>
            {% endif %}
            {{ button_new_entry }}
        </div>
        {{ pagination|raw }}
    </div>
    <section class="thread-list">
        {# Sorting #}
        {% set ascDesc %}
            <span class="sort-threads__order">
                        {% if url_params.order_dir is not defined or url_params.order_dir == 'desc' %}
                            {{ include('partials/icon.twig', {icon: 'chevron-circle-up', class: '', title: 'asc'}, with_context = false) }}
                        {% else %}
                            {{ include('partials/icon.twig', {icon: 'chevron-circle-down', class: '', title: 'desc'}, with_context = false) }}
                        {% endif %}
                    </span>
        {% endset %}
        <div class="sort-threads">
            <div class="sort-threads__column sort-threads__column--primary">
                        <span class="sort-threads__subject"><a
                                    href="{{ config.showcase_url }}{{ url.sort.subject }}"
                                    class="sort-threads__link sort-threads__link--subject">{{ lang.myshowcase_main_table_head_entry }}{% if url_params.order_by is defined and url_params.order_by == 'subject' %}{{ ascDesc }}{% endif %}</a></span>
                <span class="sort-threads__author">&mdash; <a
                            href="{{ config.showcase_url }}{{ url.sort.username }}"
                            class="sort-threads__link sort-threads__link--author">{{ lang.myshowcase_main_table_head_author }}{% if url_params.order_by is defined and url_params.order_by == 'username' %}{{ ascDesc }}{% endif %}</a></span>
            </div>
            {% for field_data in showcase.fieldset_fields %}
                {% if field_data.display_in_main_page %}
                    <div class="sort-threads__column sort-threads__column--replies">
                        <a href="{{ url.sort[field_data.field_key] }}"
                           class="sort-threads__link">{{ attribute(lang, 'myshowcase_fieldset_field_' ~ field_data.field_key) }}</a> {% if url_params.order_by is defined and url_params.order_by == field_data.field_key %}{{ ascDesc }}{% endif %}
                    </div>
                {% endif %}
            {% endfor %}
            <div class="sort-threads__column sort-threads__column--replies">
                <a href="{{ config.showcase_url }}{{ url.sort.comments }}"
                   class="sort-threads__link sort-threads__link--replies">{{ lang.myshowcase_main_table_head_comments }}{% if url_params.order_by is defined and url_params.order_by == 'comments_approved' %}{{ ascDesc }}{% endif %}</a>
            </div>
            <div class="sort-threads__column sort-threads__column--latest">
                <a href="{{ config.showcase_url }}{{ url.sort.last_comment }}"
                   class="sort-threads__link sort-threads__link--latest">{{ lang.myshowcase_main_table_head_last_comment }}{% if url_params.order_by is defined and url_params.order_by == 'dateline' %}{{ ascDesc }}{% endif %}</a>
            </div>
            {% if permissions.entries_can_view %}
                <span class="sort-threads__column sort-threads__column--checkbox">
                            <label>
                                <input type="checkbox" id="select-all-entries"/>
                            </label>
                        </span>
            {% endif %}
        </div>

        {# Select all #}
        {% if true or permissions.entries_can_view and entries_count > config.main_per_page %}
            <div class="thread-list__select-all" id="page_select_row" style="display: none;">
                {{ lang.myshowcase_main_table_separator_selected_page_start }}
                <strong>0</strong> {{ lang.myshowcase_main_table_separator_selected_page_end }}

                <a class="select_all_entries"
                   href="#">{{ lang.myshowcase_main_table_separator_selected_all_select_start }}
                    <strong>{{ entries_count }}</strong> {{ lang.myshowcase_main_table_separator_selected_all_select_end }}
                </a>
            </div>
            <div class="thread-list__select-all" id="all_select_row" style="display: none;">
                {{ lang.myshowcase_main_table_separator_selected_all_start }}
                <strong>0</strong> {{ lang.myshowcase_main_table_separator_selected_all_end }}

                <a class="selected_entries_clear"
                   href="#">{{ lang.myshowcase_main_table_separator_selected_all_clear }}</a>
            </div>
        {% endif %}

        {# Threads – errors #}
        {% if not entries_count %}
            <div class="alert alert--no-results">
                {% if url_params.keywords is defined and url_params.keywords %}
                    {{ lang.myshowcase_main_table_empty_search }}
                {% else %}
                    {{ lang.myshowcase_main_table_empty }}
                {% endif %}
            </div>
        {% else %}
            <div class="thread-list__container">
                {% if entry_sticky_objects is not empty %}
                    <div class="thread-list__normal-threads">
                        <h2 class="visually-hidden">{{ lang.myshowcase_main_table_separator_sticky }}</h2>
                    </div>
                    {% for entry_data in entry_sticky_objects %}

                        {% if permissions.entries_can_view and entry_data.status == 2 and permissions.entries_can_view %}
                            {% include '@ext.myshowcase/pageMainEntryDeleted.twig' %}
                        {% else %}
                            {% include '@ext.myshowcase/pageMainEntry.twig' %}
                        {% endif %}

                    {% endfor %}
                {% endif %}

                {% if entry_normal_objects is not empty %}
                    <div class="thread-list__normal-threads">
                        <h2 class="visually-hidden">{{ lang.myshowcase_main_table_separator_normal }}</h2>
                    </div>
                    {% for entry_data in entry_normal_objects %}

                        {% if permissions.entries_can_view and entry_data.status == 2 and permissions.entries_can_view %}
                            {% include '@ext.myshowcase/pageMainEntryDeleted.twig' %}
                        {% else %}
                            {% include '@ext.myshowcase/pageMainEntry.twig' %}
                        {% endif %}

                    {% endfor %}
                {% endif %}
            </div>
        {% endif %}

        {# Threadlist footer #}
        <div class="sort-results">
            <form action="{{ config.showcase_url }}{{ url.main }}" method="get">
                <h3 class="sort-results__title visually-hidden">{{ lang.myshowcase_main_sort_entries }}</h3>
                <div class="select-field">
                    {{ include('partials/icon.twig', {icon: 'sort', class: 'select-field__icon'}, with_context = false) }}
                    <label>
                        <select name="sort">
                            {% for field_key, field_display_name in showcase.fieldset_display_fields %}
                                <option value="{{ field_key }}"{% if url_params.order_by is defined and field_key == url_params.order_by %} selected{% endif %}>{{ lang.myshowcase_main_sort_field }}
                                    : {% if attribute(lang, 'myshowcase_main_sort_field_' ~ field_key) is defined %}{{ attribute(lang, 'myshowcase_main_sort_field_' ~ field_key) }}{% else %}{{ field_key }}{% endif %}</option>
                            {% endfor %}
                        </select>
                    </label>
                </div>
                <div class="select-field">
                    {{ include('partials/icon.twig', {icon: 'sort', class: 'select-field__icon'}, with_context = false) }}
                    <label>
                        <select name="order_dir">
                            {% for field in ['asc', 'desc'] %}
                                <option value="{{ field }}"{% if url_params.order_dir is defined and field == url_params.order_dir %} selected="selected"{% endif %}>
                                    {{ lang.myshowcase_main_sort_direction }}
                                    : {{ attribute(lang, 'myshowcase_main_sort_direction_' ~ field) }}</option>
                            {% endfor %}
                        </select>
                    </label>
                </div>
                <div class="select-field">
                    {{ include('partials/icon.twig', {icon: 'sort', class: 'select-field__icon'}, with_context = false) }}
                    <label>
                        <select name="threshold[days]">
                            <option value="1"{% if url_params.threshold.days is defined and url_params.threshold.days == 1 %} selected{% endif %}>{{ lang.myshowcase_main_sort_days_1 }}</option>
                            {% for field in [5, 25, 100] %}
                                <option value="{{ field }}"{% if url_params.threshold.days is defined and url_params.threshold.days == field %} selected{% endif %}>{{ attribute(lang, 'myshowcase_main_sort_days_' ~ field ) }}</option>
                            {% endfor %}
                        </select>
                    </label>
                </div>
                <button type="submit" class="button button--inline">
                    {{ include('partials/icon.twig', {icon: 'random', class: 'button__icon'}, with_context = false) }}
                    <span class="button__text">{{ lang.myshowcase_main_button_sort_entries }}</span>
                </button>
                {% if url_params is not empty %}
                    {% for param_key,param_value in url_params %}
                        {% if param_value is iterable %}
                            {% for nested_param_key,nested_param_value in param_value %}
                                <input type="hidden" name="{{ nested_param_key }}" value="{{ nested_param_value }}"/>
                            {% endfor %}
                        {% else %}
                            <input type="hidden" name="{{ param_key }}" value="{{ param_value }}"/>
                        {% endif %}
                    {% endfor %}
                {% endif %}
            </form>
        </div>
    </section>

    {{ pagination|raw }}

    <footer class="page-footer">
        <div class="row row--no-border page-tools">
            {# Search #}
            <div class="forum-search page-tools__item">
                <h2 class="title title--legend {% if not permissions.entries_can_view %}visually-hidden{% endif %}">{{ lang.myshowcase_main_search }}</h2>
                <form action="{{ config.showcase_url }}{{ url.main }}" method="get">
                    <label>
                        <input type="text" name="keywords"
                               placeholder="{{ lang.myshowcase_main_search_keywords }}"
                               class="textbox textbox--large"
                               value="{{ url_params.keywords is defined and url_params.keywords }}"/>
                    </label>
                    <input type="hidden" name="page" value="{{ current_page }}"/>
                    <button type="submit" class="button button--inline">
                        {{ include('partials/icon.twig', {icon: 'search', class: 'button__icon'}, with_context = false) }}
                        <span class="button__text">{{ lang.myshowcase_main_button_search }}</span>
                    </button>
                    {% if url_params is not empty %}
                        {% for param_key,param_value in url_params %}
                            {% if param_value is iterable %}
                                {% for nested_param_key,nested_param_value in param_value %}
                                    <input type="hidden" name="{{ nested_param_key }}"
                                           value="{{ nested_param_value }}"/>
                                {% endfor %}
                            {% else %}
                                <input type="hidden" name="{{ param_key }}" value="{{ param_value }}"/>
                            {% endif %}
                        {% endfor %}
                    {% endif %}
                </form>
            </div>

            {# Inline moderation #}
            {% if permissions.entries_can_view %}
                {% include '@ext.myshowcase/pageMainInlineModeration.twig' %}
            {% endif %}
        </div>

        {# Users browsing #}
        {% if config.main_display_users_browsing and (
            users_browsing_counter.members > 0 or
            (users_browsing_counter.invisible > 0 and mybb.usergroup.canviewwolinvis) or
            users_browsing_counter.guests > 0
            ) %}
            <div class="container container--small container--users-browsing">{{ lang.myshowcase_main_users_browsing }}
                {% for user in users_browsing %}
                    <a
                    href="{{ get_profile_link(user.uid) }}">{{ user.uid|format_name }}</a>{% if user.invisible %}*{% endif %}{% if loop.last == false %}{{ lang.comma }} {% endif %}
                {% endfor %}

                {% if users_browsing_counter.invisible and mybb.usergroup.canviewwolinvis != 1 %}
                    {% if users_browsing %}{{ lang.comma }} {% endif %}{{ trans('users_browsing_forum_guests', users_browsing_counter.guests) }}
                {% endif %}

                {% if users_browsing_counter.guests > 0 %}
                    {% if users_browsing or (users_browsing_counter.invisible and mybb.usergroup.canviewwolinvis != 1) %}{{ lang.comma }} {% endif %}{{ trans('myshowcase_main_users_browsing_guests', users_browsing_counter.guests) }}
                {% endif %}
            </div>
        {% endif %}
    </footer>
{% endblock body %}