{# Values from the field classes are already escaped, or parsed by the MyBB parser when the field enables it. #}
<div class="post__field field field--{{ field_data.field_definition.html_type }} field--{{ field_data.field_definition.field_key }}">
    <h5 class="field__label"><u>{{ field_data.getLabel() }}:</u></h5>
    <p class="field__value">
        {% if field_data.getUserValue() is same as('') and field_data.attachments_rendered is empty %}
            {{ lang.myshowcase_entry_field_value_empty }}
        {% elseif field_data.field_definition.html_type in ['checkbox', 'radio', 'select'] %}
            {{ field_data.getUserValueDisplay()|raw }}
        {% else %}
            {{ field_data.getUserValue()|raw }}
        {% endif %}
        {% if field_data.field_definition.html_type == 'file' %}
            {# Attachments #}
            {{ field_data.attachments_rendered|raw }}
        {% endif %}
    </p>
</div>
