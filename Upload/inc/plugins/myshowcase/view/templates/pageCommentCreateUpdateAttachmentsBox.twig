<br/>
<table border="0" cellspacing="{{ theme.borderwidth }}" cellpadding="{{ theme.tablespace }}" class="tborder">
    <tr>
        <td class="thead" colspan="3">
            <strong>{{ lang.attachments }}</strong>
        </td>
    </tr>
    <tr>
        <td class="tcat smalltext" colspan="3">
            {{ usageQuoteNote }} {{ usageDetails }}
            {% if totalUserUsage %}
                <a href="{{ mybb.settings.bburl }}/usercp.php?action=attachments">
                    {{ lang.myshowcase_attachments_view_my_attachments }}
                </a>
            {% endif %}
        </td>
    </tr>
    <tr>
        <td class="trow1" colspan="3">
            <div id="dropzoneContainer" class="dropzone">
            </div>
            <div class="flow-drop">
            </div>
        </td>
    </tr>
    <tr>
        <td class="tfoot" colspan="3">
            <label>
                <input type="checkbox" name="attachment_watermark_file" value="1" {{ watermarkSelectedElement }}>
                {{ lang.myshowcase_attachments_watermark_input }}
            </label>
        </td>
    </tr>
</table>