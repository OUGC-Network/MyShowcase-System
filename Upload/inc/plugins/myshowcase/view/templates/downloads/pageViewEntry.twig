<div class="myshowcase-downloads-detail myshowcase-package-entry myshowcase-package-entry--downloads">
    {% if entry_attachments %}
        <section class="myshowcase-downloads-detail__files" aria-label="{{ lang.myshowcase_custom_attachments_heading }}">
            {{ entry_attachments|raw }}
        </section>
    {% else %}
        <p class="myshowcase-downloads-detail__empty">{{ lang.myshowcase_custom_attachments_empty }}</p>
    {% endif %}
    {% include '@ext.myshowcase/pageViewEntry.twig' %}
</div>