<style>
    .myshowcase-download-entry { display: flex; flex-wrap: wrap; gap: 0.75rem 1.25rem; align-items: flex-start;
        border: 1px solid #d0d7de; border-radius: 6px; padding: 1rem; margin: 0.5rem 0; background: #fafbfc; }
    .myshowcase-download-entry .thread__subject { margin: 0; }
    .myshowcase-download-entry .thread__meta { font-size: 0.9rem; color: #57606a; }
</style>
<div class="row row--thread thread thread--default inline_row myshowcase-download-entry
    {% if entry.status == 2 %} thread--deleted{% endif %}
    {% if entry.status == 0 %} thread--awaiting-approval{% endif %}">

    <div class="thread__title" style="flex: 1 1 220px;">
        <h3 class="thread__subject">
            <a href="{{ entry.extra_data.url }}">{{ entry.extra_data.subject_html|raw }}</a>
        </h3>
        <div class="thread__meta">
            {{ lang.myshowcase_main_table_row_by }}
            {% if entry.user_id > 0 %}
                <a href="{{ mybb.settings.bburl|trim('/', 'right') }}/{{ get_profile_link(entry.user_id) }}">{{ entry.user_id|format_name }}</a>
            {% else %}
                {{ entry.username ?: lang.guest }}
            {% endif %}
            · {{ entry.extra_data.dateline_timestamp|my_date }}
        </div>
    </div>

    {% set main_fields = entry.getFields()|filter(field_data => field_data.isViewableInMain() and (field_data.getUserValue() is not same as('') or field_data.attachments_rendered is not empty))|sort((a, b) => a.field_definition.render_order <=> b.field_definition.render_order) %}
    {% if main_fields is not empty %}
        <div class="thread__fields" style="flex: 2 1 300px;">
            {% for field_data in main_fields %}
                <div class="thread__field thread__field--{{ field_data.field_definition.field_key }}">
                    <span class="thread__field-label">{{ field_data.getLabel() }}:</span>
                    <span class="thread__field-value">{% if field_data.hasOptions() %}{{ field_data.getUserValueDisplay()|raw }}{% else %}{{ field_data.getUserValue()|raw }}{{ field_data.attachments_rendered|raw }}{% endif %}</span>
                </div>
            {% endfor %}
        </div>
    {% endif %}

    {% if entry_moderator %}
        <div class="thread__checkbox">
            <input type="checkbox" class="checkbox checkbox--select-row" data-slug="{{ entry.public_id }}"
                   id="selected-entry-{{ entry.public_id }}"
                   {% if entry.extra_data.selected %}checked="checked"{% endif %} />
        </div>
    {% endif %}
</div>