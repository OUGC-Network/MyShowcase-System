            <input type="email"
                   name="{{ field_data.field_key }}"
                   value="{{ mybb.input[field_data.field_key] }}"
                   tabindex="{{ loop.index + 10 }}"
                   autocomplete="email"
                   inputmode="email"
                   class="textbox {% if field_data.enable_subject %}textbox--subject{% endif %}"
                   id="{{ field_data.field_key }}"
                   form="contentForm"
                   {% if field_data.read_only %}readonly="readonly"{% endif %}
                    {% if field_data.placeholder %}placeholder="{{ field_data.placeholder }}"{% endif %}
                    {% if field_data.is_required %}required="required"{% endif %}
                    {% if field_data.allow_multiple_values %}multiple="multiple"{% endif %}
                    {% if field_data.minimum_length %}minlength="{{ field_data.minimum_length }}"{% endif %}
                    {% if field_data.maximum_length %}maxlength="{{ field_data.maximum_length }}"{% endif %}
                    {% if field_data.input_size %}size="{{ field_data.input_size }}"{% endif %}
                    {% if field_data.regular_expression %}pattern="{{ field_data.regular_expression }}"{% endif %}
            />
