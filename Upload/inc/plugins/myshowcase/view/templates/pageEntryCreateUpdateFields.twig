                {% elseif field_data.html_type == 'textarea' %}
                <textarea name="{{ field_data.field_key }}"
                          tabindex="{{ loop.index + 10 }}"
                          placeholder="{{ field_data.placeholder }}"
                          rows="20"
                          cols="70"
                          id="{{ field_data.field_key }}"
                          form="contentForm"
                          {% if field_data.is_required %}required="required"{% endif %}
                        {% if field_data.minimum_length %}minlength="{{ field_data.minimum_length }}"{% endif %}
                        {% if field_data.maximum_length %}maxlength="{{ field_data.maximum_length }}"{% endif %}
                >{{ mybb.input[field_data.field_key] }}</textarea>
                {% elseif field_data.html_type == 'select' %}
                <select name="{{ field_data.field_key }}"
                        tabindex="{{ loop.index + 10 }}"
                        id="{{ field_data.field_key }}"
                        form="contentForm"
                        {% if field_data.is_required %}required="required"{% endif %}
                        {% if field_data.input_size %}size="{{ field_data.input_size }}"{% endif %}
                >
                    {% for field_data_id, field_data_data in field_data.fieldDataObjects %}
                        <option value="{{ field_data_id }}"
                                {% if mybb.input[field_data.field_key] == field_data_id %}selected="selected"{% endif %}>{{ field_data_data.value }}</option>
                    {% endfor %}
                </select>
