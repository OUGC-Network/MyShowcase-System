<div class="row row--form field">
    <h3 class="field__name visually-hidden">
        <label for="{{ field_data.field_key }}">{{ fieldHeader }}</label>
    </h3>
    {% if field_data.description is not empty %}
        <p class="field__description">{{ field_data.description }}</p>
    {% endif %}
    <div class="{% if field_data.enable_subject %}compose__subject{% else %}compose__container{% endif %}">
        {% if field_data.html_type in ['text', 'search', 'textarea'] and field_data.enable_editor %}
        <div class="compose__message compose__{{ field_data.field_key }}">
            {% endif %}
            {% if field_data.html_type == 'checkbox' %}
                <div id="{{ field_data.field_key }}">
                    {% for field_data_id, field_data_data in field_data.fieldDataObjects %}
                        <p class="option-field option-field--compact">
                            <label>
                                <input type="checkbox"
                                       name="{{ field_data.field_key }}"
                                       value="{{ field_data_id }}"
                                       tabindex="{{ loop.index + 10 }}"
                                       form="contentForm"
                                       {% if field_data.read_only %}readonly="readonly"{% endif %}
                                        {% if field_data.is_required %}required="required"{% endif %}
                                        {% if mybb.input[field_data.field_key] == field_data_id %}checked="checked"{% endif %}
                                />
                                {{ field_data_data.value }}
                            </label>
                        </p>
                    {% endfor %}
                </div>
                {% elseif field_data.html_type == 'color' %}
            <input type="color"
                   name="{{ field_data.field_key }}"
                   value="{{ mybb.input[field_data.field_key] }}"
                   tabindex="{{ loop.index + 10 }}"
                   autocomplete="color"
                   class="textbox {% if field_data.enable_subject %}textbox--subject{% endif %}"
                   id="{{ field_data.field_key }}"
                   form="contentForm"
                   {% if field_data.read_only %}readonly="readonly"{% endif %}
                    {% if field_data.is_required %}required="required"{% endif %}
                    {% if field_data.regular_expression %}pattern="{{ field_data.regular_expression }}"{% endif %}
            />
                {% elseif field_data.html_type == 'date' %}
            <input type="date"
                   name="{{ field_data.field_key }}"
                   value="{{ mybb.input[field_data.field_key] }}"
                   tabindex="{{ loop.index + 10 }}"
                   autocomplete="date"
                   class="textbox {% if field_data.enable_subject %}textbox--subject{% endif %}"
                   id="{{ field_data.field_key }}"
                   form="contentForm"
                   {% if field_data.read_only %}readonly="readonly"{% endif %}
                    {% if field_data.is_required %}required="required"{% endif %}
                    {% if field_data.minimum_length %}min="{{ field_data.minimum_length }}"{% endif %}
                    {% if field_data.maximum_length %}max="{{ field_data.maximum_length }}"{% endif %}
                    {% if field_data.step_size %}step="{{ field_data.step_size }}"{% endif %}
                    {% if field_data.regular_expression %}pattern="{{ field_data.regular_expression }}"{% endif %}
            />
                {% elseif field_data.html_type == 'datetime-local' %}
            <input type="datetime-local"
                   name="{{ field_data.field_key }}"
                   value="{{ mybb.input[field_data.field_key] }}"
                   tabindex="{{ loop.index + 10 }}"
                   autocomplete="datetime-local"
                   class="textbox {% if field_data.enable_subject %}textbox--subject{% endif %}"
                   id="{{ field_data.field_key }}"
                   form="contentForm"
                   {% if field_data.read_only %}readonly="readonly"{% endif %}
                    {% if field_data.is_required %}required="required"{% endif %}
                    {% if field_data.minimum_length %}min="{{ field_data.minimum_length }}"{% endif %}
                    {% if field_data.maximum_length %}max="{{ field_data.maximum_length }}"{% endif %}
                    {% if field_data.step_size %}step="{{ field_data.step_size }}"{% endif %}
                    {% if field_data.regular_expression %}pattern="{{ field_data.regular_expression }}"{% endif %}
            />
