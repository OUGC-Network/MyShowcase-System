<div class="inline-moderation page-tools__item">
    {{ asset('jscripts/myshowcase_inline.js', static=true) }}
    <form id="inline_moderation_form" action="{{ url.main }}" method="post">
        <h2 class="title title--legend">{{ lang.myshowcase_main_inline_moderation }}</h2>
        <div class="select-field">
            {{ include('partials/icon.twig', {icon: 'sort', class: 'select-field__icon'}, with_context = false) }}
            <label for="inlinemoderation_options_selector"></label>
            <select name="moderate" id="inlinemoderation_options_selector">
                <option value="" selected="selected">{{ lang.myshowcase_main_inline_moderation_select_a_tool }}</option>
                <optgroup label="{{ lang.myshowcase_main_inline_moderation_standard_tool }}">
                    <option value="open">{{ lang.myshowcase_main_inline_moderation_open }}</option>
                    <option value="close">{{ lang.myshowcase_main_inline_moderation_close }}</option>
                    <option value="stick">{{ lang.myshowcase_main_inline_moderation_stick }}</option>
                    <option value="unstick">{{ lang.myshowcase_main_inline_moderation_unstick }}</option>
                    <option value="approve">{{ lang.myshowcase_main_inline_moderation_approve }}</option>
                    <option value="unapprove">{{ lang.myshowcase_main_inline_moderation_unapprove }}</option>
                    <option value="copy">{{ lang.myshowcase_main_inline_moderation_copy }}</option>
                    <option value="soft_delete">{{ lang.myshowcase_main_inline_moderation_soft_delete }}</option>
                    <option value="restore">{{ lang.myshowcase_main_inline_moderation_restore }}</option>
                    <option value="delete">{{ lang.myshowcase_main_inline_moderation_delete }}</option>
                </optgroup>
            </select>
        </div>
        <button type="submit" name="go" class="button button--inline">
            {{ include('partials/icon.twig', {icon: 'arrow-right', class: 'button__icon'}, with_context = false) }}
            <span class="button__text">{{ lang.myshowcase_main_inline_moderation_go }} (<span
                        id="selected-counter">0</span>)</span>
        </button>

        <button type="button" class="button button--secondary button--inline selected_entries_clear">
            {{ include('partials/icon.twig', {icon: 'times', class: 'button__icon'}, with_context = false) }}
            <span class="button__text">{{ lang.myshowcase_main_inline_moderation_clear }}</span>
        </button>
        {% if url_params is not empty %}
            {% for param_key,param_value in url_params %}
                {% if param_value is iterable %}
                    {% for nested_param_key,nested_param_value in param_value %}
                        <input type="hidden" name="{{ nested_param_key }}" value="{{ nested_param_value }}"/>
                    {% endfor %}
                {% else %}
                    <input type="hidden" name="{{ param_key }}" value="{{ param_value }}"/>
                {% endif %}
            {% endfor %}
        {% endif %}
        <input type="hidden" name="my_post_key" value="{{ mybb.post_code }}"/>
        <input type="hidden" name="action" value="inline_moderation"/>
        <input type="hidden" id="selected-all-entries" name="selected_all_entries" value="">
        <input type="hidden" id="selected-entries" name="selected_entries" value="">
        <input type="hidden" id="unselected-entries" name="unselected_entries" value="">
    </form>
    <script type="text/javascript">
        <!--
        const go_text = "{{ lang.myshowcase_main_inline_moderation_go }}";
        const inlineType = "showcase";
        const inlineId = "{% if entry_data.entry_slug is defined %}{{ entry_data.entry_slug }}{% endif %}";

        const showcaseID = "{{ config.showcase_id }}";
        const totalEntries = "{{ total_entries }}";
        const entriesPerPage = "{{ config.main_per_page }}";

        lang.inline_moderation_no_tool_selected = "{{ lang.myshowcase_main_inline_moderation_no_tool_selected }}";
        lang.inline_moderation_no_entries_selected = "{{ lang.myshowcase_main_inline_moderation_no_entries_selected }}";
        // -->
    </script>
</div>