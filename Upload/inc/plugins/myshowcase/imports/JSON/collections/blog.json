{
    "type": "collection",
    "version": "1.1.0",
    "name": "Blog",
    "fields": [
        {
            "field_key": "category",
            "label": "Category",
            "html_type": "select",
            "field_type": "int",
            "maximum_length": 10,
            "is_enabled": 1,
            "is_required": 1,
            "display_order": 1,
            "render_order": 1,
            "enable_search": 1,
            "allowed_groups_fill": "all",
            "allowed_groups_view": "all",
            "options": [
                {"value_id": 1, "value": "News", "display_order": 1},
                {"value_id": 2, "value": "Tutorials", "display_order": 2},
                {"value_id": 3, "value": "Opinion", "display_order": 3},
                {"value_id": 4, "value": "Announcements", "display_order": 4}
            ]
        },
        {
            "field_key": "summary",
            "label": "Summary",
            "description": "A short introduction shown in the list of posts.",
            "html_type": "textarea",
            "field_type": "text",
            "maximum_length": 300,
            "is_enabled": 1,
            "display_order": 2,
            "render_order": 2,
            "allowed_groups_fill": "all",
            "allowed_groups_view": "all"
        },
        {
            "field_key": "tags",
            "label": "Tags",
            "placeholder": "news, release, howto",
            "html_type": "text",
            "field_type": "varchar",
            "maximum_length": 120,
            "is_enabled": 1,
            "display_order": 3,
            "render_order": 3,
            "enable_search": 1,
            "allowed_groups_fill": "all",
            "allowed_groups_view": "all"
        },
        {
            "field_key": "cover_image",
            "label": "Cover image",
            "description": "Optional. The http or https address of an image shown with the post.",
            "html_type": "url",
            "field_type": "varchar",
            "maximum_length": 255,
            "regular_expression": "/^(|https?:\\/\\/\\S+)$/i",
            "is_enabled": 1,
            "display_order": 4,
            "render_order": 4,
            "allowed_groups_fill": "all",
            "allowed_groups_view": "all"
        },
        {
            "field_key": "reading_time",
            "label": "Reading time",
            "description": "Optional. Whole minutes needed to read the post, 1 to 999.",
            "html_type": "number",
            "field_type": "int",
            "maximum_length": 5,
            "regular_expression": "/^([1-9][0-9]{0,2})?$/",
            "is_enabled": 1,
            "display_order": 5,
            "render_order": 5,
            "allowed_groups_fill": "all",
            "allowed_groups_view": "all"
        }
    ]
}
