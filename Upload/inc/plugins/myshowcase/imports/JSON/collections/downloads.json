{
    "type": "collection",
    "version": "1.0.0",
    "name": "Downloads",
    "fields": [
        {
            "field_key": "archive",
            "label": "File",
            "description": "The file to download: an archive or a package. The allowed types are set on the board.",
            "html_type": "file",
            "field_type": "varchar",
            "maximum_length": 255,
            "maximum_size": 51200,
            "is_enabled": 1,
            "is_required": 1,
            "display_order": 1,
            "render_order": 1,
            "display_in_main_page": 1,
            "allowed_groups_fill": "all",
            "allowed_groups_view": "all"
        },
        {
            "field_key": "category",
            "label": "Category",
            "description": "What kind of file this is.",
            "html_type": "select",
            "field_type": "int",
            "maximum_length": 10,
            "is_enabled": 1,
            "is_required": 1,
            "display_order": 2,
            "render_order": 2,
            "enable_search": 1,
            "allowed_groups_fill": "all",
            "allowed_groups_view": "all",
            "options": [
                {"value_id": 1, "value": "Tools", "display_order": 1},
                {"value_id": 2, "value": "Themes", "display_order": 2},
                {"value_id": 3, "value": "Plugins", "display_order": 3},
                {"value_id": 4, "value": "Templates", "display_order": 4},
                {"value_id": 5, "value": "Documents", "display_order": 5},
                {"value_id": 6, "value": "Other", "display_order": 6}
            ]
        },
        {
            "field_key": "version",
            "label": "Version",
            "description": "The version number, for example 1.4.2 or 2.0.0-beta.",
            "placeholder": "1.0.0",
            "html_type": "text",
            "field_type": "varchar",
            "minimum_length": 1,
            "maximum_length": 20,
            "regular_expression": "/^[0-9]+(\\.[0-9]+){0,3}([.-][0-9A-Za-z]+)?$/",
            "is_enabled": 1,
            "is_required": 1,
            "display_order": 3,
            "render_order": 3,
            "enable_search": 1,
            "allowed_groups_fill": "all",
            "allowed_groups_view": "all"
        },
        {
            "field_key": "release_date",
            "label": "Release date",
            "description": "The date of this version, as YYYY-MM-DD.",
            "html_type": "date",
            "field_type": "varchar",
            "minimum_length": 10,
            "maximum_length": 10,
            "regular_expression": "/^(|[0-9]{4}-[0-9]{2}-[0-9]{2})$/",
            "is_enabled": 1,
            "is_required": 1,
            "display_order": 4,
            "render_order": 4,
            "allowed_groups_fill": "all",
            "allowed_groups_view": "all"
        },
        {
            "field_key": "platform",
            "label": "Platform",
            "description": "The system the file is for.",
            "html_type": "select",
            "field_type": "int",
            "maximum_length": 10,
            "is_enabled": 1,
            "is_required": 1,
            "display_order": 5,
            "render_order": 5,
            "enable_search": 1,
            "allowed_groups_fill": "all",
            "allowed_groups_view": "all",
            "options": [
                {"value_id": 1, "value": "Any", "display_order": 1},
                {"value_id": 2, "value": "Windows", "display_order": 2},
                {"value_id": 3, "value": "macOS", "display_order": 3},
                {"value_id": 4, "value": "Linux", "display_order": 4},
                {"value_id": 5, "value": "Web", "display_order": 5}
            ]
        },
        {
            "field_key": "license",
            "label": "License",
            "html_type": "select",
            "field_type": "int",
            "maximum_length": 10,
            "is_enabled": 1,
            "is_required": 1,
            "display_order": 6,
            "render_order": 6,
            "allowed_groups_fill": "all",
            "allowed_groups_view": "all",
            "options": [
                {"value_id": 1, "value": "Freeware", "display_order": 1},
                {"value_id": 2, "value": "MIT", "display_order": 2},
                {"value_id": 3, "value": "GPL-2.0-or-later", "display_order": 3},
                {"value_id": 4, "value": "GPL-3.0", "display_order": 4},
                {"value_id": 5, "value": "Proprietary", "display_order": 5},
                {"value_id": 6, "value": "Other", "display_order": 6}
            ]
        },
        {
            "field_key": "requirements",
            "label": "Requirements",
            "description": "Optional. The minimum requirements, for example PHP 8.2 and MyBB 1.9.",
            "html_type": "text",
            "field_type": "varchar",
            "maximum_length": 200,
            "is_enabled": 1,
            "display_order": 7,
            "render_order": 7,
            "display_in_main_page": 0,
            "allowed_groups_fill": "all",
            "allowed_groups_view": "all"
        },
        {
            "field_key": "sha256",
            "label": "SHA-256 checksum",
            "description": "The SHA-256 checksum of the file: 64 hexadecimal characters.",
            "html_type": "text",
            "field_type": "varchar",
            "minimum_length": 64,
            "maximum_length": 64,
            "regular_expression": "/^[0-9a-fA-F]{64}$/",
            "is_enabled": 1,
            "is_required": 1,
            "display_order": 8,
            "render_order": 8,
            "display_in_main_page": 0,
            "allowed_groups_fill": "all",
            "allowed_groups_view": "all"
        },
        {
            "field_key": "changelog",
            "label": "Changelog",
            "description": "Optional. What changed in this version. MyCode is allowed.",
            "html_type": "textarea",
            "field_type": "text",
            "maximum_length": 10000,
            "is_enabled": 1,
            "display_order": 9,
            "render_order": 9,
            "display_in_main_page": 0,
            "parser_enable": 1,
            "parser_allow_html": 0,
            "parser_allow_mycode": 1,
            "parser_allow_smiles": 1,
            "parser_allow_image_code": 0,
            "parser_allow_video_code": 0,
            "allowed_groups_fill": "all",
            "allowed_groups_view": "all"
        },
        {
            "field_key": "project_url",
            "label": "Project or support link",
            "description": "Optional. The http or https address of the project or its support page.",
            "html_type": "url",
            "field_type": "varchar",
            "maximum_length": 255,
            "regular_expression": "/^(|https?:\\/\\/\\S+)$/i",
            "is_enabled": 1,
            "display_order": 10,
            "render_order": 10,
            "display_in_main_page": 0,
            "allowed_groups_fill": "all",
            "allowed_groups_view": "all"
        }
    ]
}
